 AFTER=byHuman||MODE==='two'?'':`The computer moved its ${PNAME[m.piece.toLowerCase()]} to ${CH.NAME(m.to)}.`;
 renderPieces();
 if(THEMES[THEME].motion==='walk'){const e=EL[m.to];if(e){e.classList.add('snap');sfx('snap')}if(m.flag==='OO'||m.flag==='OOO'){const r=EL[m.flag==='OO'?m.to-1:m.to+1];if(r)r.classList.add('snap')}}
 const st=CH.status(G);
 if(st.over)sfx(st.result==='mate'?'capture':'move');
 else if(m.promo)sfx('promote');else if(st.check)sfx('check');else if(m.flag==='OO'||m.flag==='OOO')sfx('castle');else if(m.cap)sfx('capture');else if(THEMES[THEME].motion!=='walk')sfx('move');
 renderHL();renderCards();
 if(st.over){finish(st);BUSY=false;return}
 turnMsg();BUSY=false;
 if(!humanTurn())aiTurn()}
async function aiTurn(){if(!G||OVER||MODE==='two'||G.turn===HUMAN)return;BUSY=true;const g=GEN;turnMsg();renderCards();
 await wait(MODE==='easy'?650:350);if(g!==GEN)return;
 const t0=Date.now();const m=CH.pickMove(G,MODE);const dt=Date.now()-t0;
 if(dt<300)await wait(300-dt);if(g!==GEN||!m){BUSY=false;return}
 await doMove(m)}
function askPromo(side){return new Promise(res=>{const R=$('promoRow');R.innerHTML='';
 ['q','r','b','n'].forEach(t=>{const b=document.createElement('button');b.type='button';b.dataset.t=t;b.title=PNAME[t];b.innerHTML=pieceSVG(t,side);b.onclick=()=>{sfx('click');$('promo').classList.remove('on');res(t)};R.appendChild(b)});
 $('promo').classList.add('on')})}
async function clickSq(i){if(!G||BUSY||OVER)return;if(!humanTurn()){sfx('nope');return}
 const p=G.b[i];
 if(SEL>=0){const ms=movesFrom(SEL).filter(m=>m.to===i);
  if(ms.length){let m=ms[0];if(ms.length>1||m.promo){BUSY=true;const t=await askPromo(G.turn);BUSY=false;m=ms.find(x=>x.promo===t)||ms[0]}doMove(m);return}}
 if(p&&CH.col(p)===G.turn){SEL=SEL===i?-1:i;sfx('click');renderHL();return}
 if(SEL>=0){SEL=-1;renderHL();sfx('nope')}}
$('board').addEventListener('pointerdown',e=>{const r=$('board').getBoundingClientRect();const i=sqAt((e.clientX-r.left)*640/r.width,(e.clientY-r.top)*640/r.height);if(i>=0)clickSq(i)});
/* ---------- end of game ---------- */
function finish(st){OVER=st;renderCards();let T='',P='',kind='draw';
 if(st.result==='mate'){const w=st.winner;
  if(MODE==='two'){T=`Checkmate! ${who(w)} wins!`;P=`Mazel tov, ${who(w)} (${SIDE(w)})! Well played, both of you.`;kind='win'}
  else if(w===HUMAN){T='Checkmate! You win!';P='Brilliant! The computer\'s king has nowhere to go. Mazel tov!';kind='win'}
  else{T='Checkmate! The computer won this one';P='Great try! Every game makes you a stronger player. Want a rematch?';kind='lose'}}
 else if(st.result==='stalemate'){T='Stalemate! It\'s a draw';P='The king is not in check, but there is no legal move left. Nobody loses!'}
 else if(st.result==='repetition'){T='It\'s a draw!';P='The same position came up three times. Nobody loses, well played!'}
 else if(st.result==='fifty'){T='It\'s a draw!';P='50 moves each with no capture and no pawn move. Nobody loses, well played!'}
 else {T='It\'s a draw!';P='Neither side has enough pieces left to checkmate. Nobody loses, well played!'}
 setMsg(T,'',false);OVER.title=T;OVER.kind=kind;
 setTimeout(()=>{if(OVER!==st)return;$('winT').textContent=T;$('winP').textContent=P;$('trophy').innerHTML=trophySVG(kind);$('win').classList.add('on');
  sfx(kind==='win'?'win':kind==='lose'?'lose':'draw');if(kind!=='lose')confetti(kind==='win'?110:50)},900/SPEED)}
function trophySVG(kind){const gold=kind==='lose'?['#d9e6f5','#9fb5cf','#6a809c']:['#ffe58a','#f2b81e','#b07c08'];
 const star=(x,y,r,c)=>{let d='';for(let i=0;i<10;i++){const a=Math.PI/5*i-Math.PI/2,rr=i%2?r*.45:r;d+=(i?'L':'M')+(x+Math.cos(a)*rr).toFixed(1)+' '+(y+Math.sin(a)*rr).toFixed(1)}return `<path d="${d}Z" fill="${c}"/>`};
 return `<svg viewBox="0 0 150 150"><defs><linearGradient id="tg" x1="0" x2="1"><stop offset="0" stop-color="${gold[2]}"/><stop offset=".35" stop-color="${gold[0]}"/><stop offset=".6" stop-color="${gold[1]}"/><stop offset="1" stop-color="${gold[2]}"/></linearGradient></defs>
 <path d="M42 28 H22 Q14 28 16 40 Q20 62 46 66" fill="none" stroke="url(#tg)" stroke-width="8"/><path d="M108 28 H128 Q136 28 134 40 Q130 62 104 66" fill="none" stroke="url(#tg)" stroke-width="8"/>
 <path d="M38 18 H112 V40 Q112 84 75 92 Q38 84 38 40 Z" fill="url(#tg)" stroke="${gold[2]}" stroke-width="2"/><rect x="66" y="90" width="18" height="18" fill="url(#tg)"/><rect x="46" y="106" width="58" height="12" rx="3" fill="url(#tg)" stroke="${gold[2]}" stroke-width="2"/><rect x="38" y="118" width="74" height="16" rx="4" fill="#7a4a22"/>
 <path d="M50 26 Q48 56 62 74" stroke="#fff" stroke-opacity=".55" stroke-width="5" fill="none" stroke-linecap="round"/>${star(75,50,15,'#fff8d6')}${star(18,10,7,'#ffd84a')}${star(136,14,6,'#ffd84a')}${star(132,96,5,'#fff2a8')}${star(14,92,5,'#fff2a8')}</svg>`}
function confetti(n){const C=$('confetti'),cols=['#e03b3b','#2f9e44','#f4c20d','#2f6fdb','#f08cb0','#ff8a1f','#7b3fb8'];
 for(let i=0;i<n;i++){const d=document.createElement('div');d.className='cf';d.style.left=Math.random()*1280+'px';d.style.background=cols[i%cols.length];
  d.style.animationDuration=(2.2+Math.random()*2)/SPEED+'s';d.style.animationDelay=Math.random()*.8/SPEED+'s';d.style.transform=`rotate(${Math.random()*360}deg)`;C.appendChild(d);setTimeout(()=>d.remove(),5200/SPEED)}}
/* ---------- buttons ---------- */
function newGame(fen){GEN++;G=CH.Game(fen);SEL=-1;LAST=null;OVER=null;HINT=null;AFTER='';BUSY=false;FLIP=MODE!=='two'&&HUMAN==='b';
 $('win').classList.remove('on');renderAll();if(!humanTurn())aiTurn()}
function undo(){if(!G||BUSY||!G.hist.length){sfx('nope');return}GEN++;sfx('click');
 if(MODE==='two')CH.takeback(G);else{do{CH.takeback(G)}while(G.hist.length&&G.turn!==HUMAN)}
 const h=G.hist[G.hist.length-1];LAST=h?h.m:null;OVER=null;HINT=null;SEL=-1;AFTER='';$('win').classList.remove('on');renderAll();
 if(!humanTurn())aiTurn()}
function hint(){if(window.PT613Tour&&PT613Tour.isOpen())return;if(!G||BUSY||OVER||!humanTurn()||$('menu').classList.contains('on')){sfx('nope');return}
 const r=CH.search(G,4,700);if(!r)return;HINT=r.move;SEL=-1;renderHL();sfx('hint');
 setMsg('Try this move!',`Move the ${PNAME[r.move.piece.toLowerCase()]} from ${CH.NAME(r.move.from)} to ${CH.NAME(r.move.to)}. Follow the arrow.`)}
$('hintBtn').onclick=hint;$('hint2').onclick=hint;
$('undoBtn').onclick=undo;
$('flipBtn').onclick=()=>{sfx('click');FLIP=!FLIP;drawBoard();renderPieces();renderHL();renderCards()};
$('newBtn').onclick=()=>{sfx('click');openMenu()};
$('againBtn').onclick=()=>{sfx('click');newGame()};
$('viewBtn').onclick=()=>{sfx('click');$('win').classList.remove('on')};
$('menuBtn').onclick=()=>{sfx('click');openMenu()};
$('lookBtn').onclick=()=>{sfx('click');openLook()};
$('lookDone').onclick=()=>{sfx('click');$('look').classList.remove('on')};
addEventListener('keydown',e=>{if(window.PT613Tour&&PT613Tour.isOpen())return;if(document.getElementById('pt613offer'))return;
 if(e.key==='Escape'){if($('look').classList.contains('on')){$('look').classList.remove('on');e.preventDefault()}else if($('win').classList.contains('on'))$('win').classList.remove('on');return}
 if(e.target&&e.target.tagName==='INPUT')return;
 if((e.key==='h'||e.key==='H')&&!$('menu').classList.contains('on'))hint();
 if((e.key==='Enter')&&$('menu').classList.contains('on')&&!$('look').classList.contains('on')){e.preventDefault();$('playBtn').click()}});
/* ---------- menu ---------- */
function openMenu(){GEN++;BUSY=false;$('win').classList.remove('on');$('menu').classList.add('on');paintMenu();if(!G){G=CH.Game();renderAll()}}
function paintMenu(){document.querySelectorAll('#oppRow .opt').forEach(b=>b.classList.toggle('sel',b.dataset.opp===MODE));
 document.querySelectorAll('#sideRow .opt').forEach(b=>b.classList.toggle('sel',b.dataset.side===HUMAN));
 $('sideWrap').style.visibility=MODE==='two'?'hidden':'visible';
 document.querySelectorAll('#sideRow .ic').forEach(e=>e.innerHTML=pieceSVG('k',e.dataset.ic));
 $('custBtn').style.visibility=THEME==='material'?'visible':'hidden';buildThemeCards();$('logo').innerHTML=pieceSVG('k','w','classic')}
document.querySelectorAll('#oppRow .opt').forEach(b=>b.onclick=()=>{sfx('click');MODE=b.dataset.opp;store.set('opp',MODE);paintMenu()});
document.querySelectorAll('#sideRow .opt').forEach(b=>b.onclick=()=>{sfx('click');HUMAN=b.dataset.side;store.set('side',HUMAN);paintMenu()});
$('playBtn').onclick=()=>{sfx('click');$('menu').classList.remove('on');newGame()};
$('custBtn').onclick=()=>{sfx('click');openLook()};
function preview(k){const T=THEMES[k],B=BOARDS[T.board()];let o=`<svg viewBox="0 0 200 96" width="200" height="96"><rect width="200" height="96" fill="${B.l}"/><rect x="0" width="50" height="96" fill="${B.d}"/><rect x="100" width="50" height="96" fill="${B.d}"/>`;
 if(k==='brick')for(let x=12.5;x<200;x+=25)for(let y=12;y<96;y+=24)o+=`<circle cx="${x}" cy="${y}" r="7" fill="#fff" opacity=".18" stroke="#000" stroke-opacity=".15"/>`;
 o+='</svg>';const pc=(t,s,x)=>`<svg viewBox="0 0 100 100" width="76" height="76" style="left:${x}px;top:12px;overflow:visible;filter:drop-shadow(0 3px 2px rgba(0,0,0,.35))">${pieceSVG(t,s,k).replace(/^<svg[^>]*>|<\/svg>$/g,'')}</svg>`;
 return o+pc('k','w',4)+pc('n','b',64)+pc('q','b',124)}
function buildThemeCards(){['themeRow','themeRow2'].forEach(id=>{const R=$(id);if(!R)return;R.innerHTML='';
 for(const k in THEMES){const b=document.createElement('button');b.type='button';b.className='tcard'+(k===THEME?' sel':'');b.dataset.theme=k;
  b.innerHTML=`<div class="pv">${preview(k)}</div><div>${tName(k)}</div><small>${tDesc(k)}</small>`;b.onclick=()=>{sfx('click');setTheme(k)};R.appendChild(b)}})}
function setTheme(k){THEME=k;store.set('theme',k);buildDefs();buildThemeCards();$('custBtn').style.visibility=THEME==='material'?'visible':'hidden';
 $('custom').classList.toggle('on',k==='material');paintCustom();HINT=HINT;renderAll();$('logo').innerHTML=pieceSVG('k','w','classic')}
/* ---------- look panel (Colour & Material) ---------- */
const SWATCH=['#f5efe2','#ffffff','#1d1d22','#c0303a','#2f5fcf','#2f9e4a','#7b3fb8','#e9b52c','#f08cb0','#1fa3a3','#8a5a2e','#9aa3ad'];
const MATS=[['wood','Wood'],['marble','Marble'],['glass','Glass'],['gold','Gold']];
function openLook(){$('look').classList.add('on');$('custom').classList.toggle('on',THEME==='material');buildThemeCards();paintCustom()}
function saveLook(){store.set('look',LOOK);buildDefs();buildThemeCards();renderAll();paintCustom(true)}
function paintCustom(soft){document.querySelectorAll('.sidebox').forEach(box=>{const s=box.dataset.s,L=LOOK[s];
  box.querySelector('.big').innerHTML=pieceSVG('k',s,'material');
  if(soft&&box.dataset.built){box.querySelectorAll('.swt').forEach(b=>b.classList.toggle('sel',b.dataset.c===L.c));box.querySelector('.swpick').value=L.c;box.querySelectorAll('.mats .opt').forEach(b=>b.classList.toggle('sel',b.dataset.m===L.m));return}
  box.dataset.built='1';
  const sw=box.querySelector('.sws');sw.innerHTML='';SWATCH.forEach(c=>{const b=document.createElement('button');b.type='button';b.className='swt'+(c===L.c?' sel':'');b.dataset.c=c;b.style.background=c;b.title=c;b.onclick=()=>{sfx('click');LOOK[s]=Object.assign({},LOOK[s],{c});saveLook()};sw.appendChild(b)});
  const inp=document.createElement('input');inp.type='color';inp.className='swpick';inp.value=L.c;inp.title=W('Any colour','Any color');inp.oninput=()=>{LOOK[s]=Object.assign({},LOOK[s],{c:inp.value});saveLook()};sw.appendChild(inp);
  const mt=box.querySelector('.mats');mt.innerHTML='';MATS.forEach(([m,n])=>{const b=document.createElement('button');b.type='button';b.className='opt'+(m===L.m?' sel':'');b.dataset.m=m;b.textContent=n;b.onclick=()=>{sfx('click');LOOK[s]=Object.assign({},LOOK[s],{m});saveLook()};mt.appendChild(b)})});
 const bs=$('bstyles');bs.innerHTML='';['wood','marble','green','blue'].forEach(k=>{const b=document.createElement('button');b.type='button';b.className='opt'+(LOOK.board===k?' sel':'');b.dataset.b=k;
  b.innerHTML=`<i style="background:linear-gradient(135deg,${BOARDS[k].l} 50%,${BOARDS[k].d} 50%)"></i>${BOARDS[k].name}`;b.onclick=()=>{sfx('click');LOOK.board=k;saveLook()};bs.appendChild(b)})}
/* ---------- tour hooks ---------- */
window.CS_TOUR={peek(on){$('menu').classList.toggle('peek',!!on)},menuOn:()=>$('menu').classList.contains('on')&&!$('look').classList.contains('on')&&!$('win').classList.contains('on')};
/* ---------- start ---------- */
buildDefs();setRegion(REGION);G=CH.Game();renderAll();openMenu();
/* ================= debug hook (tests only) ================= */
window.__csDebug={
 speed(n){SPEED=n||1},
 start(o){o=o||{};if(o.opp)MODE=o.opp;if(o.side)HUMAN=o.side;if(o.theme)setTheme(o.theme);$('menu').classList.remove('on');newGame(o.fen)},
 state(){return {turn:G.turn,fen:CH.toFEN(G),busy:BUSY,over:OVER?{result:OVER.result,winner:OVER.winner||null,kind:OVER.kind}:null,msg:$('msg').textContent,hist:G.hist.length,
  last:LAST?CH.NAME(LAST.from)+CH.NAME(LAST.to):null,theme:THEME,flip:FLIP,sel:SEL,dots:document.querySelectorAll('#hl .dot').length,hint:HINT?CH.NAME(HINT.from)+CH.NAME(HINT.to):null,
  win:$('win').classList.contains('on')?$('win').textContent:'',promo:$('promo').classList.contains('on'),mode:MODE,human:HUMAN,pieces:document.querySelectorAll('#pieces .pc').length}},
 xy(name){const i=CH.IDX(name),q=pos(i),r=$('board').getBoundingClientRect(),k=r.width/640;return {x:r.left+(q.x+40)*k,y:r.top+(q.y+40)*k}},
 move(uci){const ms=CH.legal(G).filter(m=>CH.NAME(m.from)+CH.NAME(m.to)===uci.slice(0,4)&&(!m.promo||m.promo===(uci[4]||'q')));if(!ms.length)return false;doMove(ms[0]);return true},
 legal(){return CH.legal(G).map(m=>CH.NAME(m.from)+CH.NAME(m.to)+(m.promo||''))},
 look(l){Object.assign(LOOK,l);saveLook()}, best(){const r=CH.search(G,3,400);return r?CH.NAME(r.move.from)+CH.NAME(r.move.to)+(r.move.promo||''):null}, theme(k){setTheme(k)}, undo(){undo()}, hint(){hint()}
};

