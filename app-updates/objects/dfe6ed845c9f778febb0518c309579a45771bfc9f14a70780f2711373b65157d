/* game wrapper with repetition keys */
function Game(fen){const s=fromFEN(fen||'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1');s.keys=[key(s)];return s}
