/* ---------- level builder ---------- */
const FH=4; // tiles per floor
function LB(cols,rows,theme){
  this.c=cols;this.r=rows;this.theme=theme;this.G=rows-3;
  this.t=new Uint8Array(cols*rows); this.s=new Uint8Array(cols*rows); this.lad=new Uint8Array(cols*rows);
  this.bldgs=[];this.decor=[];this.ents=[];this.tips=[];this.movers=[];this.start={x:2,y:this.G};
}
const TS={street:1,brick:2,roof:3,fe:4,wood:5,barrel:6,crate:7,steel:8,rock:9,chim:10,ac:11,container:12,awning:13,car:14,plank:15,girder:16,ledge:17,tank:18,bin:19,deck:20};
LB.prototype={
  inb(x,y){return x>=0&&y>=0&&x<this.c&&y<this.r;},
  set(x,y,t,s){if(this.inb(x,y)){this.t[y*this.c+x]=t;this.s[y*this.c+x]=s||0;}},
  fill(x,y,w,h,t,s){for(let j=y;j<y+h;j++)for(let i=x;i<x+w;i++)this.set(i,j,t,s);},
  carve(x,y,w,h){for(let j=y;j<y+h;j++)for(let i=x;i<x+w;i++){this.set(i,j,0,0);}},
  plat(x,y,w,s){for(let i=x;i<x+w;i++)this.set(i,y,2,s||TS.ledge);},
  solid(x,y,w,h,s){this.fill(x,y,w,h,1,s||TS.brick);},
  ladder(x,y0,y1){for(let y=y0;y<=y1;y++)if(this.inb(x,y))this.lad[y*this.c+x]=1;},
  e(type,x,y,o){const en=Object.assign({type,x:x*T+T/2,y:y*T},o||{});this.ents.push(en);return en;},
  juice(x,y){return this.e('juice',x,y);},
  juiceRow(x,y,n,step){for(let i=0;i<n;i++)this.juice(x+i*(step||1),y);},
  juiceArc(x0,y,x1){const n=Math.max(2,Math.round((x1-x0)));for(let i=0;i<=n;i++){const f=i/n;this.e('juice',x0+(x1-x0)*f,y-Math.sin(f*Math.PI)*2.2);}},
  person(x,y,kind,msg){return this.e('person',x,y,{kind,msg});},
  guard(x,y,x0,x1,spd,boss){return this.e('guard',x,y,{x0:x0*T+12,x1:(x1+1)*T-12,spd:spd||55,boss:!!boss});},
  secret(x,y){return this.e('secret',x,y);},
  power(x,y,kind){return this.e('power',x,y,{kind});},
  check(x,y){return this.e('check',x,y);},
  exit(x,y,kind){return this.e('exit',x,y,{kind:kind||'barrel'});},
  tip(x,y,text){return this.e('tip',x,y,{text});},
  pot(x,y){return this.e('pot',x,y);},
  vent(x,y){return this.e('vent',x,y);},
  pigeons(x,y,n){return this.e('pigeons',x,y,{n:n||3});},
  mover(x,y,w,ax,ay,period,phase){this.movers.push({bx:x*T,by:y*T,w:w*T,ax:ax*T,ay:ay*T,period:period||4,phase:phase||0,x:x*T,y:y*T,dx:0,dy:0});},
  deco(kind,x,y,o){this.decor.push(Object.assign({kind,x:x*T,y:y*T},o||{}));},
  awning(x,y,w,col){for(let i=x;i<x+w;i++)this.set(i,y,2,TS.awning);this.deco('awning',x,y,{w,col:col||'#2f8f46'});},
  car(x,col){this.solid(x,this.G-1,3,1,TS.car);this.deco('car',x,this.G,{col:col||'#d9534f'});},
  bin(x){this.solid(x,this.G-1,1,1,TS.bin);},
  /* a building: background facade + roof + optional fire escape */
  bldg(x,w,f,o){
    o=o||{}; const G=o.base!=null?o.base:this.G, R=G-f*FH;
    const b={x,w,f,R,G,sty:o.sty||'brown',shop:o.shop||null,seed:x*7+w*13+f};
    this.bldgs.push(b);
    this.plat(x,R,w,TS.roof);
    if(o.fe&&f>=2){
      const s=o.fe==='L'?x+1:x+w-5, e=s+3;
      for(let k=1;k<f;k++)this.plat(s,G-FH*k,4,TS.fe);
      let col=o.fe==='L'?s:e; this.ladder(col,G-FH,G-1);
      for(let k=1;k<f-1;k++){col=(k%2===1)?(o.fe==='L'?e:s):(o.fe==='L'?s:e);this.ladder(col,G-FH*(k+1),G-FH*k-1);}
      col=((f-1)%2===1)?(o.fe==='L'?e:s):(o.fe==='L'?s:e); this.ladder(col,R,G-FH*(f-1)-1);
      b.fe={s,e};
    }
    if(o.lad){const col=o.lad==='L'?x:x+w-1; this.ladder(col,R,G-1); b.lad=col;}
    if(o.shop&&o.awn!==false){this.awning(x+Math.floor(w/2)-1,G-3,3,o.awnCol);}
    const prev=this.bldgs[this.bldgs.length-2];
    if(prev&&prev.x+prev.w===x&&prev.G===G&&o.link!==false){
      if(R<prev.R){this.ladder(x,R,prev.R);this.set(x,prev.R,2,TS.ledge);}
      else if(R>prev.R){const c=x-1;this.ladder(c,prev.R,R);this.set(c,R,2,TS.ledge);}
    }
    return b;
  },
  tower(x,R){ // water tower on a roof; tank top is a platform with a ladder
    this.deco('tower',x,R);
    this.plat(x,R-4,3,TS.tank); this.ladder(x+1,R-4,R-1);
  },
  feP(b,k,kind,msg,side){const s=b.fe.s+(side==null?1:side); return this.person(s,b.G-FH*k,kind,msg);},
  chim(x,R,h){this.solid(x,R-(h||1),1,h||1,TS.chim);},
  ac(x,R){this.solid(x,R-1,2,1,TS.ac);},
  roofJuice(b,skip){for(let i=b.x+1;i<b.x+b.w-1;i+=2){if(skip&&skip.includes(i))continue; if(this.t[(b.R-1)*this.c+i]===0)this.juice(i,b.R-1);}},
  ground(x0,x1){for(let x=x0;x<=x1;x++){this.set(x,this.G,1,TS.street);for(let y=this.G+1;y<this.r;y++)this.set(x,y,1,TS.street);}}
};

