  $('#cLevels').onclick=()=>{SFX.click();Wd=null;clearLater();clearToast();setTip(null);renderLevels();show('levels');G.state='levels';playTrack('title');};
  $('#tRetry').onclick=()=>{SFX.click();startLevel(G.li);}; $('#tLevels').onclick=()=>{SFX.click();Wd=null;clearLater();clearToast();setTip(null);renderLevels();show('levels');G.state='levels';};
  $('#wAgain').onclick=()=>{SFX.click();openStory();}; $('#wLevels').onclick=()=>{SFX.click();Wd=null;clearLater();clearToast();setTip(null);renderLevels();show('levels');G.state='levels';};
  document.querySelectorAll('.muteBtn').forEach(b=>b.onclick=(e)=>{e.stopPropagation();auResume();setMuted(!AU.muted);});
