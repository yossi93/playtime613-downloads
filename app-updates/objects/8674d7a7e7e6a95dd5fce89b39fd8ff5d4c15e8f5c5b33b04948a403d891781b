/* touch controls: one d-pad (slide your thumb) + a big jump button */
function setupTouch(){
  const pad=$('#dpad'), jb=$('#jumpBtn'); let padId=null, jumpIds=new Set();
  const dir=(e)=>{const r=pad.getBoundingClientRect(); const dx=e.clientX-(r.left+r.width/2), dy=e.clientY-(r.top+r.height/2); const dz=r.width*0.12;
    touchState.l=dx<-dz&&Math.abs(dx)>Math.abs(dy)*0.5; touchState.r=dx>dz&&Math.abs(dx)>Math.abs(dy)*0.5;
    touchState.u=dy<-dz&&Math.abs(dy)>Math.abs(dx)*0.6; touchState.d=dy>dz&&Math.abs(dy)>Math.abs(dx)*0.6;
    pad.dataset.dir=(touchState.u?'u':'')+(touchState.d?'d':'')+(touchState.l?'l':'')+(touchState.r?'r':'');};
  const clear=()=>{touchState.l=touchState.r=touchState.u=touchState.d=false;pad.dataset.dir='';};
  pad.addEventListener('pointerdown',e=>{e.preventDefault();auResume();padId=e.pointerId;try{pad.setPointerCapture(e.pointerId);}catch(_){}dir(e);});
  pad.addEventListener('pointermove',e=>{if(e.pointerId===padId){e.preventDefault();dir(e);}});
  const up=e=>{if(e.pointerId===padId){padId=null;clear();}};
  pad.addEventListener('pointerup',up); pad.addEventListener('pointercancel',up); pad.addEventListener('lostpointercapture',up);
  jb.addEventListener('pointerdown',e=>{e.preventDefault();auResume();jumpIds.add(e.pointerId);touchState.j=true;jb.classList.add('down');try{jb.setPointerCapture(e.pointerId);}catch(_){}});
  const jup=e=>{jumpIds.delete(e.pointerId);if(!jumpIds.size){touchState.j=false;jb.classList.remove('down');}};
  jb.addEventListener('pointerup',jup); jb.addEventListener('pointercancel',jup); jb.addEventListener('lostpointercapture',jup);
  ['touchstart','touchmove','touchend'].forEach(ev=>{$('#pad').addEventListener(ev,e=>{e.preventDefault();},{passive:false});});
  $('#stage').addEventListener('touchmove',e=>{if(G.state==='play')e.preventDefault();},{passive:false});
  document.addEventListener('gesturestart',e=>e.preventDefault());
  document.addEventListener('dblclick',e=>e.preventDefault());
}
function layout(){
  const touch=('ontouchstart' in window)||navigator.maxTouchPoints>0||/[?&]touch=1/.test(location.search);
  const vv=window.visualViewport, vw=vv?vv.width:innerWidth, vh=vv?vv.height:innerHeight;
  document.body.classList.toggle('touch',touch);
  document.body.classList.toggle('portrait',vh>vw*1.1);
  resize(); stackOverlays();
}
addEventListener('resize',layout);
addEventListener('orientationchange',()=>{layout();setTimeout(layout,250);setTimeout(layout,600);});
if(window.visualViewport)visualViewport.addEventListener('resize',layout);
/* whenever the play area itself changes size (control pad appears/hides, toolbar slides, rotation) re-fit the canvas */
if(window.ResizeObserver)new ResizeObserver(()=>{const r=document.getElementById('stage').getBoundingClientRect(); if(Math.floor(r.width)!==VIEW.cw||Math.floor(r.height)!==VIEW.ch)resize();}).observe(document.getElementById('stage'));

let lastT=performance.now(), acc=0; const STEP=1/60;
let MANUAL=false;
function frame(now){
  requestAnimationFrame(frame); if(MANUAL){lastT=now;return;}
  let dt=(now-lastT)/1000; lastT=now; if(dt>0.25)dt=0.25;
  if(G.state==='play'&&Wd){
    acc+=dt; let n=0;
    while(acc>=STEP&&n<5){pollInput(); if(IN.bot&&IN.bot.tick)IN.bot.tick(Wd); updWorld(Wd,STEP); acc-=STEP; n++; if(G.state!=='play')break;}
    if(n>=5)acc=0;
    if(Wd.def.timer){const el=$('#hTimer'); el.textContent='⏰ '+fmtT(Wd.timeLeft); el.classList.toggle('low',Wd.timeLeft<30);}
  }
  if(Wd&&(G.state==='play'||G.state==='paused'||G.state==='complete'||G.state==='timeup'))render();
  else renderMenuBG(now/1000);
}
function renderMenuBG(t){ // gentle animated skyline behind menus
  const c=ctx; c.setTransform(1,0,0,1,0,0); const W2=cv.width,H2=cv.height;
  const g=c.createLinearGradient(0,0,0,H2); g.addColorStop(0,'#123b2a'); g.addColorStop(1,'#0b1a14'); c.fillStyle=g; c.fillRect(0,0,W2,H2);
}
