function auTick(){
  if(!AU.ctx||!AU.track||AU.ctx.state!=='running')return; if(!AU.musicOn){AU.nextT=AU.ctx.currentTime+0.05;return;} const tr=TRACKS[AU.track]; const sp=60/tr.bpm/2;
  if(AU.nextT<AU.ctx.currentTime-0.2)AU.nextT=AU.ctx.currentTime+0.05;
  while(AU.nextT<AU.ctx.currentTime+0.25){
    const i=AU.step%32, t=AU.nextT;
    const m=tr.mel[i]; if(m)tone(N(m),sp*1.6,'square',0.22,0,t,AU.music);
    const b=tr.bass[i]; if(b)tone(N(b),sp*0.9,'triangle',0.5,0,t,AU.music);
