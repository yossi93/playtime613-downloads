  g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(vol||0.3,t+0.01); g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  o.connect(g); g.connect(dest||AU.sfx); o.start(t); o.stop(t+d+0.02);
