function solidAtPx(w,px,py){return tileT(w,Math.floor(px/T),Math.floor(py/T))===1;}
function moveX(w,e,dx){
  let nx=e.x+dx; const hw=e.w/2, top=e.y-e.h+1, bot=e.y-1;
  const r0=Math.floor(top/T), r1=Math.floor(bot/T);
  if(dx>0){const c=Math.floor((nx+hw)/T); for(let r=r0;r<=r1;r++)if(tileT(w,c,r)===1){nx=c*T-hw-0.01;e.vx=0;break;}}
  else if(dx<0){const c=Math.floor((nx-hw)/T); for(let r=r0;r<=r1;r++)if(tileT(w,c,r)===1){nx=(c+1)*T+hw+0.01;e.vx=0;break;}}
  e.x=clamp(nx,hw,w.cols*T-hw);
}
function moveY(w,e,dy,ignoreOne){
  let ny=e.y+dy; const hw=e.w/2-0.5; const c0=Math.floor((e.x-hw)/T), c1=Math.floor((e.x+hw)/T);
  let landed=null;
  if(dy>0){
    const r0=Math.floor((e.y)/T), r1=Math.floor(ny/T);
    outer: for(let r=r0;r<=r1;r++){const top=r*T; if(top<e.y-0.5)continue;
      for(let c=c0;c<=c1;c++){const tt=tileT(w,c,r); if(tt===1||(tt===2&&!ignoreOne)){ if(ny>=top){ny=top;landed={t:tt,s:tileS(w,c,r),c,r};break outer;} } } }
  } else if(dy<0){
    const r=Math.floor((ny-e.h)/T);
    for(let c=c0;c<=c1;c++)if(tileT(w,c,r)===1){ny=(r+1)*T+e.h;e.vy=0;break;}
  }
  e.y=ny; return landed;
}
