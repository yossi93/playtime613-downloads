 sbdHallMen(10).forEach((p,i)=>bAfter(.3+i*.2,()=>sayP(p,pick(['Mazel tov!','Mazel tov!!','\uD83C\uDF6C']),1.8)));try{sfx.pop();}catch(e){}
 const cg={t:0,n:N,made:0,got:0,kids_n:0,list:[],kids:[]};s.cg=cg;
 sbdSpots(N).forEach((p,i)=>bAfter(.9+i*.09,()=>{if(s.cg!==cg)return;const o={x:p.x,z:p.z,alive:1,g:sbdCandyMesh(p.x,p.z)};extra.push(o.g);
