const CAMS={out:{tx:0,ty:4.5,tz:1,yaw:.26,dist:54,min:22,max:110,pitch:[.2,.85]},in:{tx:-3,ty:0,tz:-1,yaw:.12,dist:28,min:10,max:50,pitch:[.95,1.25]},up:{tx:-4,ty:GAL,tz:4.5,yaw:.15,dist:24,min:10,max:40,pitch:[.85,1.15]}};
