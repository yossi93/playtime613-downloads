  goNode(P,sbdNode(o),[{x:o.x,y:F,z:o.z}],()=>{dTry(()=>{if(o.alive&&D.sbd===s){sbdCatch(o,false);if(Math.random()<.5)sayP(P,pick(['Got one!','Yum!','\uD83C\uDF6C!']),1.4);}k.o=null;k.cool=.5;});});});
 if((cg.made>=cg.n&&!alive.length)||cg.t>17){if(cg.t>17)alive.forEach(o=>sbdCatch(o,false));sbdCandyEnd();}}
