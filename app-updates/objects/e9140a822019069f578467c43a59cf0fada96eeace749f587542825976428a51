 if(!bm){const dz=[P,Fa].filter(Boolean);sbdDance(dz,true);bAfter(1.5,()=>notes(V3(-4,2.6,-2.5)));bAfter(4.5,()=>{sbdDance(dz,false);goalDone('au_candy');go();});}
 else{bAfter(.1,()=>goalDone('bm_candy'));bAfter(3,go);}}
