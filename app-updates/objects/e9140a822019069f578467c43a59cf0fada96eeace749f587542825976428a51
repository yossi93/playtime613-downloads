function sbdCandyTick(dt){const s=D.sbd,cg=s.cg;cg.t+=dt;const alive=cg.list.filter(o=>o.alive);
 cg.kids.forEach(k=>{const P=k.p;if(!P||!P.g.parent)return;if(k.o&&!k.o.alive)k.o=null;if(k.o)return;k.cool-=dt;if(k.cool>0||P.state==='walk')return;
