function camGoal(v){const c=CAMS[v];cam.g={tx:c.tx,ty:c.ty,tz:c.tz,yaw:c.yaw,dist:c.dist};}
function updateCamera(dt){const g=cam.g;const k=1-Math.exp(-dt*3.2);cam.tx=lerp(cam.tx,g.tx,k);cam.ty=lerp(cam.ty,g.ty,k);cam.tz=lerp(cam.tz,g.tz,k);cam.dist=lerp(cam.dist,g.dist,k);let dy=g.yaw-cam.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));cam.yaw+=dy*k;
 const C2=CAMS[VIEW];const aspect=innerWidth/innerHeight;const df=aspect<.8?1.45:aspect<1.2?1.15:1;const kk=clamp((cam.dist-C2.min)/(C2.max-C2.min),0,1);const pT=lerp(C2.pitch[0],C2.pitch[1],kk*.6+.2);if(cam.p==null||!isFinite(cam.p)){cam.p=pT;cam.df=df;}cam.p=lerp(cam.p,pT,k);cam.df=lerp(cam.df,df,k);const pitch=cam.p;const d=cam.dist*cam.df;
 camera.position.set(cam.tx+Math.sin(cam.yaw)*Math.cos(pitch)*d,cam.ty+Math.sin(pitch)*d,cam.tz+Math.cos(cam.yaw)*Math.cos(pitch)*d);camera.lookAt(cam.tx,cam.ty,cam.tz);}
const BOUNDS={out:[-40,25,-25,22],in:[-12,12,-10,9],up:[-12,4,1,9]};
function clampCam(){const b=BOUNDS[VIEW];cam.g.tx=clamp(cam.g.tx,b[0],b[1]);cam.g.tz=clamp(cam.g.tz,b[2],b[3]);const c=CAMS[VIEW];cam.g.dist=clamp(cam.g.dist,c.min,c.max);}
