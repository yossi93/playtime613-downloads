   else say("That's not the right PIN. Please try again.",true);
   return;
  }
  if(first==null){ var no=opts.reject?opts.reject(entry):grownReject(entry); if(no){ entry=""; draw(); shake(); say(no,true); return; }
   first=entry; entry=""; draw(); title(); return; }
  if(entry===first){ if(opts.save)opts.save(entry); else setPin(entry); closePin(); opts.ok&&opts.ok(); return; }
