function hash(s){ var h=0x811c9dc5, h2=0x12345; for(var r=0;r<400;r++){ for(var i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619)>>>0; h2=(Math.imul(h2^h,2246822519)+r)>>>0; } s=s+":"+h.toString(36); s=s.slice(-48); } return h.toString(16)+h2.toString(16); }
