function mins(t){ var m=/^(\d{1,2}):(\d{2})$/.exec(t||""); return m?(+m[1])*60+(+m[2]):null; }
function blockAt(pid,ms){
 var k=kid(pid), d=new Date(ms), t=d.getHours()*60+d.getMinutes(), wd=d.getDay(), yd=(wd+6)%7;
 for(var i=0;i<k.blocks.length;i++){
  var b=k.blocks[i], f=mins(b.from), e=mins(b.to), days=(b.days&&b.days.length)?b.days:[0,1,2,3,4,5,6];
