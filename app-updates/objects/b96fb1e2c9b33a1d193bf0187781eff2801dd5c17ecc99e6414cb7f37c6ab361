 {el:'#gb-draughts',title:'',text:''},
 {el:'#musicSw',title:'Music',text:'Turn the music **on or off** here.'},
 {el:'#hintBtn',title:'Hints',text:'Stuck? Press the **light bulb** (or the H key) and I\'ll show you a good move.'}];
