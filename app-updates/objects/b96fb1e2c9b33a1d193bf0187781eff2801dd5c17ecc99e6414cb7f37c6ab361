<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Board Game Box - Playtime613</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;font-family:"Trebuchet MS","Segoe UI",Roboto,Arial,sans-serif;color:#3a2412;user-select:none;-webkit-user-select:none;touch-action:manipulation;
 background:#6b3f1f radial-gradient(ellipse at 50% 40%,#a8693a 0%,#7a4522 55%,#4a2812 100%)}
*{box-sizing:border-box}
button{font-family:inherit;cursor:pointer}
#stage{position:absolute;left:0;top:0;width:1280px;height:720px;transform-origin:0 0}
.screen{position:absolute;inset:0;display:none}
.screen.on{display:block}
/* ---------- top bar ---------- */
#topbar{position:absolute;right:14px;top:10px;display:flex;gap:10px;align-items:center;z-index:50}
.tb{height:46px;border:0;border-radius:23px;padding:0 16px;font-size:18px;font-weight:900;color:#4a2a10;background:linear-gradient(#fff7e2,#f1d9a8);box-shadow:0 4px 0 #9c6a35,0 6px 10px rgba(0,0,0,.25);display:flex;align-items:center;gap:8px}
.tb:active{transform:translateY(3px);box-shadow:0 1px 0 #9c6a35}
#hintBtn{width:52px;padding:0;justify-content:center;font-size:24px}
.sw{width:50px;height:26px;border-radius:13px;background:#b9a07a;position:relative;transition:background .2s;box-shadow:inset 0 2px 3px rgba(0,0,0,.3)}
.sw::after{content:"";position:absolute;left:3px;top:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.4)}
.on .sw,.sw.on{background:#3aa655}.on .sw::after,.sw.on::after{left:27px}
#regionSw{display:flex;gap:0;border-radius:23px;overflow:hidden;box-shadow:0 4px 0 #9c6a35,0 6px 10px rgba(0,0,0,.25)}
#regionSw button{height:46px;border:0;padding:0 12px;font-weight:900;font-size:16px;background:#f6e6c4;color:#7a5a36;display:flex;align-items:center;gap:6px}
#regionSw button.sel{background:#fff;color:#2a1a0a}
#regionSw svg{width:28px;height:17px;border-radius:2px}
.pt613how.tb{font-size:18px}
.ingame #topbar .pt613how{display:none}
/* ---------- menu ---------- */
#menu{background:#f2deb6}
.room{position:absolute;left:0;top:0;width:1280px;height:720px;overflow:visible}
.room .px1,.room .px2,.room .px3{transition:transform .25s ease-out}
#title{position:absolute;left:36px;top:18px;font-size:50px;font-weight:900;color:#7a3b10;letter-spacing:1px;text-shadow:0 3px 0 #fff3d6,0 6px 8px rgba(0,0,0,.2)}
