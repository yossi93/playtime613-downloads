.opt.sel{border-color:#2f9e44;background:#eaffea;box-shadow:0 4px 0 #2f9e44}
.lab{font-size:17px;font-weight:900;color:#a07850;margin-top:10px;text-transform:uppercase;letter-spacing:1px}
.go{border:0;border-radius:20px;padding:14px 40px;font-size:28px;font-weight:900;color:#3a2000;background:linear-gradient(#ffd75e,#ffb703);box-shadow:0 6px 0 #c98a00;margin-top:14px}
.go:active{transform:translateY(4px);box-shadow:0 2px 0 #c98a00}
.plain{border:0;background:none;font-size:19px;font-weight:800;color:#8a6a48;margin-top:10px;padding:8px 16px}
/* ---------- game ---------- */
#game{background:#f2deb6}
#boardWrap{position:absolute;left:24px;top:40px;width:664px;height:664px;border-radius:22px;padding:12px;transform-origin:50% 100%;transform:perspective(1500px) rotateX(9deg) scale(.88);
 background:linear-gradient(135deg,#c8874a,#8e5326 50%,#b9773f);box-shadow:0 26px 34px rgba(40,15,0,.6),0 8px 0 #5e3416,inset 0 2px 0 rgba(255,255,255,.35)}
