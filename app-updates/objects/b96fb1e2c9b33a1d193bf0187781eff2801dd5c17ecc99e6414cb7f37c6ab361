.modal{position:absolute;inset:0;background:rgba(40,20,5,.55);display:none;align-items:center;justify-content:center;z-index:60}
.modal.on{display:flex}
.card{background:#fffaf0;border:6px solid #c98b4a;border-radius:28px;box-shadow:0 18px 40px rgba(0,0,0,.45);padding:22px 30px 24px;min-width:600px;max-width:760px;text-align:center}
.card h2{margin:0 0 6px;font-size:36px;color:#7a3b10}
.card .sub{font-size:19px;font-weight:700;color:#8a6a48;margin-bottom:12px}
.row{display:flex;gap:14px;justify-content:center;margin:10px 0}
.opt{border:4px solid #e2c79f;background:#fff;border-radius:18px;padding:10px 18px;font-size:21px;font-weight:900;color:#5a3a1a;min-width:120px;box-shadow:0 4px 0 #d8b98a}
.opt.big{min-width:250px;padding:12px 16px;display:flex;align-items:center;gap:12px;text-align:left}
