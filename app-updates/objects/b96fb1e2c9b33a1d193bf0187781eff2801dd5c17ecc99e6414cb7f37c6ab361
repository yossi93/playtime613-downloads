#turn{height:78px;border-radius:22px;display:flex;align-items:center;gap:12px;padding:0 18px;font-size:27px;font-weight:900;color:#fff;background:#888;
 box-shadow:0 6px 0 rgba(0,0,0,.25),inset 0 2px 0 rgba(255,255,255,.3);text-shadow:0 2px 0 rgba(0,0,0,.3);transition:background .3s}
