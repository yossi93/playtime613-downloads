function drStart(){const b=[];for(let r=0;r<8;r++){b.push([]);for(let c=0;c<8;c++){let v=0;if((r+c)%2===1){if(r<3)v=-1;else if(r>4)v=1}b[r].push(v)}}return b}
function drJumps(b,r,c,v,path,caps,out){const king=Math.abs(v)===2,side=Math.sign(v);let any=false;
 for(const [dr,dc] of [[-1,-1],[-1,1],[1,-1],[1,1]]){if(!king&&dr!==-side)continue;const mr=r+dr,mc=c+dc,lr=r+2*dr,lc=c+2*dc;
  if(lr<0||lr>7||lc<0||lc>7)continue;const m=b[mr][mc];if(m===0||Math.sign(m)===side||b[lr][lc]!==0)continue;
  if(caps.some(x=>x[0]===mr&&x[1]===mc))continue;
  any=true;const nb=b.map(x=>x.slice());nb[r][c]=0;nb[mr][mc]=0;nb[lr][lc]=v;const np=path.concat([[lr,lc]]),nc=caps.concat([[mr,mc]]);
  const crowned=!king&&((side===1&&lr===0)||(side===-1&&lr===7));
  if(crowned)out.push({path:np,caps:nc});else drJumps(nb,lr,lc,v,np,nc,out)}
 if(!any&&caps.length)out.push({path,caps})}
function drMoves(b,side){const caps=[],steps=[];
 for(let r=0;r<8;r++)for(let c=0;c<8;c++){const v=b[r][c];if(!v||Math.sign(v)!==side)continue;
  const out=[];drJumps(b,r,c,v,[[r,c]],[],out);out.forEach(o=>caps.push(o));
  if(!caps.length){const king=Math.abs(v)===2;for(const [dr,dc] of [[-1,-1],[-1,1],[1,-1],[1,1]]){if(!king&&dr!==-side)continue;const nr=r+dr,nc=c+dc;
   if(nr<0||nr>7||nc<0||nc>7||b[nr][nc])continue;steps.push({path:[[r,c],[nr,nc]],caps:[]})}}}
 return caps.length?caps:steps}
function drApply(b,m){const nb=b.map(x=>x.slice()),[r0,c0]=m.path[0],[r1,c1]=m.path[m.path.length-1];let v=nb[r0][c0];nb[r0][c0]=0;m.caps.forEach(([r,c])=>nb[r][c]=0);
 if(v===1&&r1===0)v=2;if(v===-1&&r1===7)v=-2;nb[r1][c1]=v;return nb}
function drEval(b){let s=0;for(let r=0;r<8;r++)for(let c=0;c<8;c++){const v=b[r][c];if(!v)continue;const a=Math.abs(v),sd=Math.sign(v);
 let w=a===2?165:100;if(a===1)w+=(sd===1?(7-r):r)*4;if(c>1&&c<6&&r>1&&r<6)w+=4;if(a===1&&((sd===1&&r===7)||(sd===-1&&r===0)))w+=6;s+=sd*w}return s}
function drSearch(b,side,depth,al,be){const ms=drMoves(b,side);if(!ms.length)return -100000-depth;if(depth===0)return side*drEval(b);
 let best=-1e9;for(const m of ms){const v=-drSearch(drApply(b,m),-side,depth-1,-be,-al);if(v>best)best=v;if(best>al)al=best;if(al>=be)break}return best}
function drBest(b,side,level){const ms=drMoves(b,side);if(level==='easy'){if(Math.random()<.55)return pick(ms);let bm=ms[0],bv=-1e9;ms.forEach(m=>{const v=side*drEval(drApply(b,m))+Math.random()*20;if(v>bv){bv=v;bm=m}});return bm}
 let bm=ms[0],bv=-1e9;const sh=ms.slice().sort(()=>Math.random()-.5);for(const m of sh){const v=-drSearch(drApply(b,m),-side,4,-1e9,1e9);if(v>bv){bv=v;bm=m}}return bm}
function drXY(r,c){return {x:c*DC+DC/2,y:r*DC+DC/2}}
function drawDraughts(){const sv=$('board');sv.innerHTML='';
 for(let r=0;r<8;r++)for(let c=0;c<8;c++){const dark=(r+c)%2===1;mk('rect',{x:c*DC,y:r*DC,width:DC,height:DC,fill:dark?'#8f5a2e':'#f1dcb2'},sv);
  if(dark)mk('rect',{x:c*DC+3,y:r*DC+3,width:DC-6,height:DC-6,fill:'none',stroke:'rgba(255,255,255,.07)','stroke-width':2},sv)}
 G.hl=mk('g',{},sv);G.pl=mk('g',{},sv);drRender()}
function drPiece(v,r,c){const p=drXY(r,c),g=mk('g',{class:'tok',transform:'translate('+p.x+','+p.y+')'},G.pl),red=v>0,main=red?'#d63a3a':'#f5ecd8',dark=red?'#8a1a1a':'#9a8660',lite=red?'#f07a6a':'#ffffff';
 mk('circle',{class:'ring',r:36,fill:'none',stroke:'#ffd34d','stroke-width':5},g);
 const sh=mk('ellipse',{cx:3,cy:8,rx:31,ry:29,fill:'rgba(0,0,0,.35)'},g),b=mk('g',{},g);
 mk('circle',{cy:4,r:30,fill:dark},b);mk('circle',{r:30,fill:main,stroke:dark,'stroke-width':2},b);
 mk('circle',{r:21,fill:'none',stroke:dark,'stroke-width':2,opacity:.6},b);mk('circle',{r:13,fill:'none',stroke:dark,'stroke-width':1.5,opacity:.4},b);
 mk('path',{d:'M-20 -14 A24 24 0 0 1 8 -24',stroke:lite,'stroke-width':4,fill:'none','stroke-linecap':'round',opacity:.8},b);
 if(Math.abs(v)===2)b.insertAdjacentHTML('beforeend','<path d="M-16 8 L-18 -10 L-8 -2 L0 -14 L8 -2 L18 -10 L16 8Z" fill="#f4c20d" stroke="#8a6a00" stroke-width="2" stroke-linejoin="round"/><circle cx="0" cy="-15" r="3" fill="#f4c20d" stroke="#8a6a00"/><rect x="-16" y="7" width="32" height="5" rx="2" fill="#e0a800" stroke="#8a6a00"/>');
 g._b=b;g._sh=sh;g._base=30;g._red=red;
 g.addEventListener('click',()=>drClick(r,c));return g}
function drTray(){const [r]=drCount(1),[w]=drCount(-1);$('trR').innerHTML='<i style="background:#f5ecd8"></i>'.repeat(12-w);$('trW').innerHTML='<i style="background:#d63a3a"></i>'.repeat(12-r)}
function drRender(){drTray();G.pl.innerHTML='';G.pieces={};for(let r=0;r<8;r++)for(let c=0;c<8;c++)if(G.b[r][c])G.pieces[r+','+c]=drPiece(G.b[r][c],r,c);drHL()}
function drHL(){G.hl.innerHTML='';Object.values(G.pieces).forEach(g=>g.classList.remove('can'));if(!G.waiting)return;
 const ms=G.moves.filter(m=>pathPrefix(m,G.prefix));
 if(!G.prefix.length){new Set(ms.map(m=>m.path[0].join(','))).forEach(k=>G.pieces[k]&&G.pieces[k].classList.add('can'));return}
 const [sr,sc]=G.prefix[G.prefix.length-1],sp=drXY(sr,sc);mk('rect',{x:sc*DC+2,y:sr*DC+2,width:DC-4,height:DC-4,fill:'none',stroke:'#ffd34d','stroke-width':5,rx:8},G.hl);
 new Set(ms.map(m=>m.path[G.prefix.length]).filter(Boolean).map(x=>x.join(','))).forEach(k=>{const [r,c]=k.split(',').map(Number),p=drXY(r,c);
  const t=mk('circle',{class:'tgt',cx:p.x,cy:p.y,r:17,fill:'rgba(255,211,77,.85)',stroke:'#fff','stroke-width':3},G.hl);t.addEventListener('click',()=>drClick(r,c));
  const big=mk('rect',{class:'tgt',x:c*DC,y:r*DC,width:DC,height:DC,fill:'transparent'},G.hl);big.addEventListener('click',()=>drClick(r,c))})}
function pathPrefix(m,pre){for(let i=0;i<pre.length;i++){if(!m.path[i]||m.path[i][0]!==pre[i][0]||m.path[i][1]!==pre[i][1])return false}return true}
function drClick(r,c){if(!G||G.kind!=='draughts'||!G.waiting)return;const side=G.side;
 // choose / re-choose a piece
 if(G.b[r][c]&&Math.sign(G.b[r][c])===side&&G.prefix.length<=1){const ok=G.moves.some(m=>m.path[0][0]===r&&m.path[0][1]===c);
  if(!ok){sfx('nope');if(G.moves[0].caps.length)setMsg('You must jump! A piece that can jump is glowing.');return}G.prefix=[[r,c]];sfx('tap');drHL();return}
 if(!G.prefix.length)return;
 const np=G.prefix.concat([[r,c]]),ms=G.moves.filter(m=>pathPrefix(m,np));if(!ms.length){sfx('nope');return}
 G.waiting=false;drAnimStep(G.prefix[G.prefix.length-1],[r,c]).then(()=>{G.prefix=np;const done=ms.find(m=>m.path.length===np.length);
  if(done&&ms.length===1||done&&ms.every(m=>m.path.length===np.length)){G.waiting=false;G.chosen(done)}else{G.waiting=true;drHL();setMsg('Keep jumping! Click the next spot.')}})}
async function drAnimStep(a,b){const g=G.pieces[a[0]+','+a[1]];if(!g)return;G.pl.appendChild(g);const p=drXY(a[0],a[1]),q=drXY(b[0],b[1]);const jump=Math.abs(a[0]-b[0])===2;
 if(jump)sfx('hop');else sfx('tap');
 await hopG(g,p,q,jump?46:14,jump?380:260,{ease:true,grow:jump?.12:.04});sfx('tap');
 delete G.pieces[a[0]+','+a[1]];G.pieces[b[0]+','+b[1]]=g;
 if(jump){const mr=(a[0]+b[0])/2,mc=(a[1]+b[1])/2,cg=G.pieces[mr+','+mc];if(cg){sfx('capture');delete G.pieces[mr+','+mc];await flyToTray(cg)}}}
/* a taken piece pops up off the board and flies into the tray */
async function flyToTray(cg){const red=cg._red,tray=$(red?'trW':'trR'),st=$('stage').getBoundingClientRect(),r=cg.getBoundingClientRect();
 const fx=(r.left+r.width/2-st.left)/SCALE,fy=(r.top+r.height/2-st.top)/SCALE;
 const slot=document.createElement('i');slot.style.background=red?'#d63a3a':'#f5ecd8';slot.style.visibility='hidden';tray.appendChild(slot);
 const sr=slot.getBoundingClientRect(),tx=(sr.left+sr.width/2-st.left)/SCALE,ty=(sr.top+sr.height/2-st.top)/SCALE;
 await tween(160,k=>{cg.setAttribute('opacity',1);setLift(cg,Math.sin(k*Math.PI/2)*20,1+.25*k,1+.25*k)});cg.remove();
 const f=document.createElement('div');f.className='flyer';f.style.background=red?'radial-gradient(circle at 35% 30%,#f07a6a,#d63a3a 55%,#8a1a1a)':'radial-gradient(circle at 35% 30%,#fff,#f5ecd8 55%,#9a8660)';$('stage').appendChild(f);
 await tween(520,k=>{const e=ease(k),x=fx+(tx-fx)*e,y=fy+(ty-fy)*e-Math.sin(Math.PI*k)*120,s=1.9-1.0*e;f.style.transform='translate('+(x-13).toFixed(1)+'px,'+(y-13).toFixed(1)+'px) scale('+s.toFixed(2)+') rotate('+(k*360).toFixed(0)+'deg)'});
 f.remove();slot.style.visibility='';slot.classList.add('popin');sfx('click')}
function drCount(side){let n=0,k=0;G.b.forEach(row=>row.forEach(v=>{if(v&&Math.sign(v)===side){n++;if(Math.abs(v)===2)k++}}));return [n,k]}
function drStatus(p,i){const [n,k]=drCount(i===0?1:-1);return n+' pieces'+(k?', '+k+' king'+(k>1?'s':''):'')}
async function draughtsLoop(run){
 while(run===RUN&&!G.over){const pi=G.cur,p=G.players[pi],side=pi===0?1:-1;G.side=side;drawPlist(drStatus);
  const ms=drMoves(G.b,side);
  if(!ms.length){G.over=true;const w=G.players[1-pi];setMsg(COL[p.col].n+' has no moves left.');await wait(700);return showWin(w)}
  if(G.quiet>=60){G.over=true;await wait(300);return showWin(null)}
  const human=!p.ai&&!G.autoHuman;let mv;
  setTurn(p,human?COL[p.col].n+"'s turn!":COL[p.col].n+' is thinking...');
  if(human){G.moves=ms;G.prefix=[];G.waiting=true;
   setMsg(ms[0].caps.length?'You <b>must jump</b>! Click the glowing piece, then where to jump.':'Click one of your glowing pieces, then click where it goes.');drHL();
   mv=await new Promise(res=>{G.chosen=res});if(run!==RUN)return;drHL()}
  else{await wait(aiDelay());if(run!==RUN)return;mv=drBest(G.b,side,p.ai||'medium');
   for(let i=0;i<mv.path.length-1;i++){await drAnimStep(mv.path[i],mv.path[i+1]);if(run!==RUN)return}}
  const before=G.b[mv.path[0][0]][mv.path[0][1]];G.b=drApply(G.b,mv);const end=mv.path[mv.path.length-1],after=G.b[end[0]][end[1]];
  G.quiet=mv.caps.length?0:(G.quiet||0)+1;
  if(Math.abs(before)===1&&Math.abs(after)===2){sfx('king');setMsg('<b>Crowned!</b> '+COL[p.col].n+' has a new king. Kings move forwards and backwards.')}
  else if(mv.caps.length)setMsg(COL[p.col].n+' jumped '+(mv.caps.length>1?mv.caps.length+' pieces!':'a piece!'));
  G.waiting=false;drRender();G.cur=1-pi;await wait(250)}
}

