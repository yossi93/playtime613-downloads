 c.innerHTML=h;$('win').classList.add('on');G.winner=p?p.col:'draw';if(p)setTurn(p,COL[p.col].n+' wins!');else $('turnTxt').textContent='A draw!';rollWaiter=null;$('rollBtn').disabled=true;
 if(p&&!(p.ai&&humans===1)){sfx('win');confetti()}else sfx(p?'home':'win');
 $('wAgain').onclick=()=>{sfx('click');startGame({auto:G.autoHuman})};$('wHome').onclick=()=>{sfx('click');goMenu()}}
/* ================= hint ================= */
function hintRing(x,y,r){if(!G||!G.tokLayer&&!G.hl)return;const lay=G.kind==='draughts'?G.hl:G.tokLayer,g=mk('g',{},lay);
 mk('circle',{cx:x,cy:y,r:r,fill:'rgba(255,211,77,.35)',stroke:'#ffd34d','stroke-width':6,class:'ring',style:'display:block'},g);setTimeout(()=>g.remove(),2600)}
function hint(){if(window.PT613Tour&&PT613Tour.isOpen())return;sfx('click');
 if(!G){toast('Click a game box in the cupboard to start!');return}
 if(G.over){toast('Press <b>Play again</b> for another game!');return}
 const p=G.players[G.cur];
 if(G.kind==='ladders'){if(rollWaiter){toast('Press <b>Roll!</b> Green good-deed squares take you <b>up a ladder</b>. Orange oops squares send you <b>down a slide</b>.',3600)}else toast('Wait for '+COL[p.col].n+' to finish the turn.');return}
 if(G.kind==='ludo'){if(rollWaiter){toast(p.toks.every(s=>s<0)?'Press <b>Roll!</b> You need a <b>6</b> to bring a pawn out of your base.':'Press <b>Roll!</b> Try to land on another pawn to send it back to base!',3400);return}
  if(pickWaiter){const m=luBest(G.cur,pickMoves,'medium');const i=m.from<0?p.toks.findIndex(s=>s<0):p.toks.findIndex(s=>s===m.from);const c=luCell(p.col,p.toks[i],i);hintRing(c.x,c.y,26);
   toast(luCaptures(G.cur,m).length?'This pawn can land on someone and send them back to base!':m.from<0?'Bring a new pawn out!':m.to===56?'This pawn can get all the way home!':'Try moving the pawn with the yellow circle.',3000);return}
  toast('Wait for '+COL[p.col].n+' to finish the turn.');return}
 if(G.kind==='draughts'){if(!G.waiting){toast('Wait for '+COL[p.col].n+' to move.');return}
  let ms=G.moves.filter(m=>pathPrefix(m,G.prefix));let b=drBest(G.b,G.side,'medium');if(!pathPrefix(b,G.prefix))b=ms[0];
  const k=Math.max(0,G.prefix.length-1),a=drXY(b.path[k][0],b.path[k][1]),t=drXY(b.path[k+1][0],b.path[k+1][1]);hintRing(a.x,a.y,36);hintRing(t.x,t.y,30);
  toast(b.caps.length?'Jump! Move the piece in the yellow circle over the other piece.':'Try moving the piece in the yellow circle to the other yellow circle.',3000)}}
$('hintBtn').onclick=hint;
