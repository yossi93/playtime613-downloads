.pchip svg{width:30px;height:40px;flex:0 0 auto}
.pchip .role{font-size:14px;color:#8a6a48}
.pchip .st{font-size:14px;color:#8a6a48;font-weight:800}
.pchip.cur{border-color:#ffd34d;box-shadow:0 0 0 3px rgba(255,211,77,.4)}
#diceArea{margin-top:16px;height:170px;position:relative;display:flex;align-items:center;gap:22px;justify-content:center;background:rgba(0,0,0,.18);border-radius:24px;
 background-image:radial-gradient(ellipse at 50% 40%,#2f8a4e,#1f6a38);box-shadow:inset 0 4px 14px rgba(0,0,0,.45)}
#dice{width:150px;height:150px;position:relative;cursor:pointer;perspective:700px}
