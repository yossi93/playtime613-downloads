 if($('menu').classList.contains('on')){const f=Math.round(top+518*SCALE);b.background='repeating-linear-gradient(90deg,rgba(255,255,255,.18) 0 '+(34*SCALE)+'px,rgba(0,0,0,0) '+(34*SCALE)+'px '+(68*SCALE)+'px) 0 0/100% '+f+'px no-repeat,linear-gradient(#f4e2c0 0,#efd6a9 '+f+'px,#8a5a2e '+f+'px,#6e4420 100%)'}
 else{const t=Math.round(top+356*SCALE);b.background='linear-gradient(#f2deb6 0,#f2deb6 '+t+'px,#b9763c '+t+'px,#7a4218 100%)'}}
