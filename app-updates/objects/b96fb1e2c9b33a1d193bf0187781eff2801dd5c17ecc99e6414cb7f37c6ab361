#dice .face,#dice .core{position:absolute;inset:0;border-radius:20px;backface-visibility:hidden;display:grid;grid-template:repeat(3,1fr)/repeat(3,1fr);padding:15px;
 background:radial-gradient(circle at 30% 25%,#ffffff 0%,#fbf6ec 45%,#e9dcc4 100%);box-shadow:inset 0 0 0 2px rgba(150,120,80,.25),inset -6px -8px 14px rgba(120,90,50,.22),inset 5px 6px 10px rgba(255,255,255,.9)}
