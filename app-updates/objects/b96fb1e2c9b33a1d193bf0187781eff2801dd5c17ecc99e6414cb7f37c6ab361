#msg{margin-top:14px;min-height:96px;background:#fff8e6;border:3px solid #e2c79f;border-radius:20px;padding:12px 16px;font-size:22px;font-weight:800;color:#4a2a10;display:flex;align-items:center;gap:12px;box-shadow:0 5px 0 rgba(0,0,0,.2)}
#msg svg{width:64px;height:64px;flex:0 0 auto}
