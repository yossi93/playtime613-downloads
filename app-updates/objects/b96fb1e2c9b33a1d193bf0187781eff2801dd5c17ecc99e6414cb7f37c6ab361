#gbtns button:active{transform:translateY(3px);box-shadow:0 2px 0 #9c6a35}
.dr #diceArea,.dr #rollBtn{display:none}
#drTray{display:none;margin-top:14px;background:url() ,radial-gradient(ellipse at 50% 40%,#2f8a4e,#1f6a38);border-radius:22px;padding:10px 16px;box-shadow:inset 0 4px 14px rgba(0,0,0,.45)}
.dr #drTray{display:block}
#drTray .tr{display:flex;align-items:center;gap:12px;min-height:46px}
#drTray .tr span{flex:0 0 150px;color:#e8ffe8;font-weight:900;font-size:17px}
#drTray .tr div{display:flex;flex-wrap:wrap;gap:3px}
#drTray i.popin{animation:popin .35s cubic-bezier(.2,1.8,.4,1)}
@keyframes popin{from{transform:scale(1.8)}to{transform:scale(1)}}
.flyer{position:absolute;left:0;top:0;width:26px;height:26px;border-radius:50%;z-index:40;pointer-events:none;box-shadow:0 6px 8px rgba(0,0,0,.4),inset 0 0 0 4px rgba(0,0,0,.12)}
#drTray i{width:26px;height:26px;border-radius:50%;display:block;box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 0 0 4px rgba(0,0,0,.12)}
/* svg pieces */
.tok{cursor:default}
.tok.can{cursor:pointer}
.tok.can .ring{display:block}
.ring{display:none;animation:ringp .6s ease-in-out infinite alternate}
@keyframes ringp{from{opacity:.4}to{opacity:1}}
.tgt{cursor:pointer}
/* win */
#win{position:absolute;inset:0;z-index:70;display:none;align-items:center;justify-content:center;background:rgba(30,15,0,.45)}
#win.on{display:flex}
#confetti{position:fixed;left:0;top:0;width:100vw;height:100vh;pointer-events:none;z-index:5;display:none}
#veil{position:fixed;inset:0;background:rgba(40,20,5,.55);display:none;z-index:-1}
body.veil #veil{display:block}
#stage{z-index:1}
#winCard{position:relative;background:#fffaf0;border:7px solid #ffb703;border-radius:32px;padding:24px 44px 26px;text-align:center;box-shadow:0 20px 50px rgba(0,0,0,.5);animation:winpop .6s cubic-bezier(.2,1.6,.4,1)}
@keyframes winpop{from{transform:scale(.3) rotate(-8deg);opacity:0}to{transform:none;opacity:1}}
#winCard h1{margin:0;font-size:52px;color:#d9480f}
#winCard .who{font-size:32px;font-weight:900;margin:6px 0 4px}
#winCard svg.trophy{width:120px;height:120px}
#winCard .places{display:flex;flex-direction:column;gap:4px;align-items:flex-start;margin:6px auto 2px;width:max-content}
#winCard .place{display:flex;align-items:center;gap:10px;font-size:26px;font-weight:900}
#winCard .place small{font-size:17px;color:#8a6a48}
#winCard svg.trophy{width:96px;height:96px}
#toast{position:absolute;left:50%;top:300px;transform:translateX(-50%);background:#fff8e6;border:5px solid #ffb703;border-radius:22px;padding:14px 24px;font-size:24px;font-weight:900;color:#4a2a10;z-index:65;display:none;box-shadow:0 10px 30px rgba(0,0,0,.4);max-width:640px;text-align:center}
#toast.on{display:block;animation:tpop .4s}
@keyframes tpop{0%{transform:translateX(-50%) scale(.85);opacity:0}100%{transform:translateX(-50%) scale(1);opacity:1}}
.ingame #toast{left:1034px;top:548px;width:440px;font-size:21px;padding:12px 18px}
</style>
