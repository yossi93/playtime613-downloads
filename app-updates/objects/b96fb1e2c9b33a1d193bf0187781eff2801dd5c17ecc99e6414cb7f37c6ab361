<script>/* Playtime613 desktop shim: this game's own save space + Home */
(function(){
 var G="board-game-box", P, real;
 try{ real=window.localStorage; }catch(e){ return; }
 /* player profiles: Player 1 ("p1", also every save made before profiles existed) keeps "pt613:<game>:";
    every other player gets "pt613@<player id>:<game>:". The home screen sets the active player before any game opens. */
 var A="p1"; try{ A=real.getItem("pt613meta:active")||"p1"; }catch(e){}
 if(!/^p[a-z0-9]+$/.test(A)) A="p1";
 P=(A==="p1"?"pt613:":"pt613@"+A+":")+G+":";
 function own(){var a=[];for(var i=0;i<real.length;i++){var k=real.key(i);if(k&&k.indexOf(P)===0)a.push(k.slice(P.length));}return a;}
 var api={
  getItem:function(k){return real.getItem(P+k);},
  setItem:function(k,v){real.setItem(P+k,String(v));},
  removeItem:function(k){real.removeItem(P+k);},
  clear:function(){own().forEach(function(k){real.removeItem(P+k);});},
  key:function(i){var a=own();return i>=0&&i<a.length?a[i]:null;}
 };
 var store=new Proxy(api,{
  get:function(t,k){ if(k==="length")return own().length; if(typeof k==="symbol"||k in t)return t[k]; var v=real.getItem(P+k); return v===null?undefined:v; },
  set:function(t,k,v){ if(typeof k==="symbol"||k in t||k==="length")return true; real.setItem(P+k,String(v)); return true; },
  has:function(t,k){ return (k in t)||(typeof k==="string"&&real.getItem(P+k)!==null); },
  deleteProperty:function(t,k){ if(typeof k==="string")real.removeItem(P+k); return true; },
  ownKeys:function(){ return own(); },
  getOwnPropertyDescriptor:function(t,k){ var v=typeof k==="string"?real.getItem(P+k):null; return v===null?undefined:{value:v,writable:true,enumerable:true,configurable:true}; }
 });
 try{ Object.defineProperty(window,"localStorage",{configurable:true,enumerable:true,get:function(){return store;}}); window.__PT613_NS=P; }catch(e){}
 function home(){ try{ if(window.parent&&window.parent!==window){ window.parent.postMessage({pt613:"home"},"*"); return; } }catch(e){} }
 window.PT613_HOME=home;
 /* links: the app has no website. "/" or playtime613 links = back to the Playtime613 home screen; any other outside link does nothing */
 function isOut(h){ h=String(h||""); if(!h||h.charAt(0)==="#"||/^javascript:/i.test(h))return false; if(/^(https?:)?\/\//i.test(h)||/^(mailto|tel|sms|whatsapp|intent):/i.test(h)) return !/^(https?:)?\/\/(127\.0\.0\.1|localhost)(:\d+)?\//i.test(h); return false; }
 document.addEventListener("click",function(e){
  var a=e.target&&e.target.closest?e.target.closest("a[href]"):null; if(!a)return;
  var h=a.getAttribute("href")||""; if(h.charAt(0)==="#"||/^javascript:/i.test(h))return;
  e.preventDefault(); e.stopPropagation();
  if(h==="/"||/playtime613/i.test(h)||/^\.\.?\/?$/.test(h)) home();
 },true);
 document.addEventListener("submit",function(e){ var f=e.target; if(f&&isOut(f.getAttribute&&f.getAttribute("action"))){ e.preventDefault(); e.stopPropagation(); } },true);
 /* website-only bits (the site footer and its games button, get-the-app/buy links) are hidden inside the app */
 var WEB=/more\s+playtime613|playtime613\.co|get\s+the\s+app|download\s+the\s+app|buy\s+now|full\s+version|app\s+store|google\s+play/i;
 try{ var st=document.createElement("style"); st.textContent="#pt613footer,.pt-about,[data-pt613-web]{display:none!important}"; (document.head||document.documentElement).appendChild(st); }catch(e){}
 function sweep(root){ try{
  var as=(root||document).querySelectorAll?(root||document).querySelectorAll("a[href],[onclick*='http'],[data-href]"):[];
  for(var i=0;i<as.length;i++){ var a=as[i], h=a.getAttribute("href")||a.getAttribute("data-href")||"";
   if(WEB.test(a.textContent||"")||/playtime613\./i.test(h)){ a.setAttribute("data-pt613-web","1"); continue; }
   if(isOut(h)){ a.removeAttribute("href"); a.removeAttribute("target"); a.style.cursor="default"; } }
  var bs=(root||document).querySelectorAll?(root||document).querySelectorAll("button,.btn,.pill"):[];
  for(var j=0;j<bs.length;j++){ if(WEB.test(bs[j].textContent||"")&&(bs[j].textContent||"").length<60) bs[j].setAttribute("data-pt613-web","1"); }
 }catch(e){} }
 document.addEventListener("DOMContentLoaded",function(){ sweep(document); try{ var t=0; new MutationObserver(function(){ if(t)return; t=setTimeout(function(){t=0;sweep(document);},60); }).observe(document.documentElement,{childList:true,subtree:true}); }catch(e){} });

 /* recorded narrator: when the game asks the device voice to speak, play the matching pre-recorded sentence clips
    (voice/<id>.mp3, listed in window.PT613_VOICE by the voice/map.js the build adds); any sentence without a clip uses the
    best natural device voice. Timing and triggers stay the game's own: speak/cancel/speaking/onend all behave as before. */
 (function(){ var SS; try{ SS=window.speechSynthesis; }catch(e){} if(!SS||!SS.speak) return;
  var oSpeak=SS.speak.bind(SS), oCancel=SS.cancel.bind(SS), tok=0, playing=false, curA=null, BV=null;
  var pd=null; try{ pd=Object.getOwnPropertyDescriptor(Object.getPrototypeOf(SS),"speaking"); }catch(e){}
  /* emoji and symbols (✔ 💡 ⭐ …) are never read aloud by a device voice */
  function CL(t){ return String(t).replace(/[\u2190-\u21FF\u2300-\u23FF\u25A0-\u27BF\u2B00-\u2BFF\uFE0F\u200D]|[\uD83C-\uD83E][\uDC00-\uDFFF]/g,"").replace(/\s+/g," ").trim(); }
  function N(t){ return String(t).toLowerCase().replace(/\u2019/g,"'").replace(/[^a-z0-9']+/g," ").replace(/'/g,"").replace(/\s+/g," ").trim(); }
  var SENT=/[^.!?\u2026\n]+(?:[.!?\u2026]+["'\u201D\u2019)]*|$)/g;
  function NETONLY(v){ return !!v&&(v.localService===false||/\bonline\b|natural/i.test(v.name||"")); } function NETV(){ try{ return navigator.onLine!==false&&!window.__pt613NoNetVoice; }catch(e){ return false; } } try{ window.addEventListener("online",function(){BV=null;}); window.addEventListener("offline",function(){BV=null;}); }catch(e){} /* offline fix 1.0.5: online voices need the internet */
  function bestVoice(){ if(BV) return BV; var vs=[]; try{ vs=SS.getVoices()||[]; }catch(e){}
   var en=vs.filter(function(v){return /^en/i.test(v.lang)&&(NETV()||!NETONLY(v));}); function f(re,lr){ for(var i=0;i<en.length;i++){ if(re.test(en[i].name)&&(!lr||lr.test(en[i].lang))&&!/female/i.test(en[i].name)) return en[i]; } return null; }
   BV=(NETV()&&(f(/natural|online/i,/GB/i)||f(/natural|online/i)))||f(/ryan|george|thomas|daniel|guy|male/i,/GB/i)||f(/./,/GB/i)||en[0]||null; return BV; }
  try{ SS.addEventListener&&SS.addEventListener("voiceschanged",function(){BV=null;}); }catch(e){}
  function better(v,from){ try{ if(from&&from.lang&&/^he/i.test(from.lang)) return; var b=bestVoice(); if(b){ v.voice=b; v.lang=b.lang; if(NETONLY(b)) v.addEventListener("error",function(){ window.__pt613NoNetVoice=1; BV=null; }); } v.rate=Math.min((from&&from.rate)||1,0.95); v.pitch=1.08; if(from&&from.volume!=null) v.volume=from.volume; }catch(e){} }
  function fire(u,type){ try{ u.dispatchEvent(new Event(type)); }catch(e){} }
  SS.cancel=function(){ tok++; playing=false; if(curA){ try{curA.pause();}catch(e){} curA=null; } try{ oCancel(); }catch(e){} };
  SS.speak=function(u){
   var M=window.PT613_VOICE||null, text=(u&&u.text)||"";
   if(!M||(u&&u.lang&&/^he/i.test(u.lang))) return oSpeak(u);
   var parts=(text.match(SENT)||[]).map(function(s){return s.trim();}).filter(function(s){return /[A-Za-z]{2}/.test(s);});
   function L(p){ var k=N(p); if(M[k]) return M[k]; var w=k.split(" "); if(w.length>1&&w.length<=4){ for(var d=1;d<w.length;d++){ var k2=w.slice(0,w.length-d).join(" "); if(M[k2]) return M[k2]; } } return null; }
   parts=[].concat.apply([],parts.map(function(p){ if(L(p)) return [p]; var c=p.indexOf(': '); if(c>0){ var a=p.slice(0,c+1), b=p.slice(c+2); if(L(a)&&L(b)) return [a,b]; } return [p]; }));
   var hit=parts.some(function(p){return L(p);});
   if(hit) parts=parts.filter(function(p){ return L(p)||N(p).split(" ").length>1; }); /* a lone name with no clip is left out rather than read by a second voice */
   if(!hit){ try{ var ct=CL(text); if(ct!==text) u.text=ct; }catch(e){} if(!window.PT613_VOICE_KEEP) better(u,u); return oSpeak(u); }
   var my=++tok, i=0; playing=true; window.__pt613VoiceLog=(window.__pt613VoiceLog||[]); fire(u,"start");
   function done(){ if(my!==tok) return; playing=false; curA=null; fire(u,"end"); }
   function dev(p,again){ if(my!==tok) return; window.__pt613VoiceLog.push("tts:"+p); var v=new SpeechSynthesisUtterance(CL(p)); better(v,u); var fin=false, st=false, net=NETONLY(v.voice); function ok(){ if(fin) return; fin=true; next(); } function bad(){ if(fin) return; fin=true; if(net&&!again&&my===tok){ window.__pt613NoNetVoice=1; BV=null; try{ oCancel(); }catch(e){} return dev(p,true); } next(); } v.onstart=function(){ st=true; }; v.onend=ok; v.onerror=bad; if(net) setTimeout(function(){ if(!st) bad(); },6000); try{ oSpeak(v); }catch(e){ bad(); } }
   function next(){ if(my!==tok) return; if(i>=parts.length) return done(); var p=parts[i++], f=L(p);
    if(!f) return dev(p);
    if(f==="silent"){ window.__pt613VoiceLog.push("silent:"+p); return setTimeout(next,0); } /* a line this game keeps text-only */
    window.__pt613VoiceLog.push("clip:"+f);
    var a=new Audio("voice/"+f); curA=a; try{ a.volume=(u.volume==null?1:u.volume); }catch(e){}
    var moved=false; function go(){ if(moved) return; moved=true; next(); }
    a.onended=go; a.onerror=function(){ if(!moved){ moved=true; dev(p); } };
    var pr=a.play(); if(pr&&pr.catch) pr.catch(function(){ if(!moved){ moved=true; dev(p); } });
   }
   next();
  };
  try{ Object.defineProperty(SS,"speaking",{configurable:true,get:function(){ return playing||(pd&&pd.get?pd.get.call(SS):false); }}); }catch(e){}
 })();
 window.open=function(){return null;};
 /* F11 = full screen, handled by the app window */
 window.addEventListener("keydown",function(e){ if(e.key==="F11"){ e.preventDefault(); try{window.parent.postMessage({pt613:"key",key:"F11"},"*");}catch(err){} } },true);
