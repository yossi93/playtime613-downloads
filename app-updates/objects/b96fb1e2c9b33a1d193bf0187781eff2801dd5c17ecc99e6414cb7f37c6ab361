 TOUR_STEPS[3].title=W('Draughts','Checkers');TOUR_STEPS[3].text='Pieces move **diagonally**. Jump over a piece to take it, and if you can jump, you **must**! Reach the far side to become a **king**.'}
tourTexts();
if(window.PT613Tour)PT613Tour.setup({id:GID,name:'Board Game Box',mascot:'\u2684',accent:'#c98b4a',steps:TOUR_STEPS,
 startButton:{into:'#topbar',label:'How to play',cls:'tb',before_el:'#musicSw'},
 offerText:'Shalom! Want a quick tour?',offerSub:'I\'ll show you the games in the cupboard.',
 isStartScreen:()=>$('menu').classList.contains('on')&&!$('setup').classList.contains('on')&&!$('note').classList.contains('on'),
 muted:()=>true,onOpen:()=>{$('setup').classList.remove('on');$('note').classList.remove('on');if(G)goMenu()}});
const _sr=setRegion;
setRegion=function(r){_sr(r);tourTexts()};
setRegion(REGION);paintBody();
function veil(){document.body.classList.toggle('veil',['setup','note','win'].some(i=>$(i).classList.contains('on')))}
new MutationObserver(veil).observe($('stage'),{subtree:true,attributes:true,attributeFilter:['class']});
/* gentle parallax on the room */
addEventListener('pointermove',e=>{const dx=e.clientX/innerWidth-.5,dy=e.clientY/innerHeight-.5;
 document.querySelectorAll('.room .px1').forEach(g=>g.style.transform='translate('+(-dx*6).toFixed(1)+'px,'+(-dy*4).toFixed(1)+'px)');
 document.querySelectorAll('.room .px2').forEach(g=>g.style.transform='translate('+(-dx*12).toFixed(1)+'px,'+(-dy*6).toFixed(1)+'px)');
 document.querySelectorAll('.room .px3').forEach(g=>g.style.transform='translate('+(dx*6).toFixed(1)+'px,'+(dy*3).toFixed(1)+'px)')},{passive:true});
/* ================= debug hook (tests only) ================= */
window.__bgDebug={
 speed(n){SPEED=n||1},force(a){FORCE=a.slice()},
 start(game,o){o=o||{};S.game=game;S.mode=o.mode||'cpu';S.n=o.n||2;S.level=o.level||'easy';if(o.finish)S.finish=o.finish;if(o.ludoMode)S.ludoMode=o.ludoMode;$('setup').classList.remove('on');startGame({auto:o.auto,autoLevel:o.autoLevel})},
 auto(on){if(G)G.autoHuman=!!on},
 state(){if(!G)return {screen:'menu'};return {skipVisible:$('skipBtn').classList.contains('on'),kind:G.kind,finish:G.finish,ludoMode:G.ludoMode,places:(G.placeCols||G.places.map(i=>G.players[i].col)),msg:$('msgTxt').textContent,winText:$('win').classList.contains('on')?$('winCard').textContent:'',cur:G.cur,over:G.over,winner:G.winner||null,err:G.err||null,waitingRoll:!!rollWaiter,waitingPick:!!pickWaiter,drWaiting:!!G.waiting,
  players:G.players.map(p=>({col:p.col,ai:p.ai,pos:p.pos,toks:p.toks})),board:G.b||null,quiet:G.quiet}},
 setPos(i,pos){G.players[i].pos=pos;layoutLS()},
 setToks(i,t){G.players[i].toks=t.slice();layoutLudo();drawPlist(luStatus)},
 setBoard(b){G.b=b.map(r=>r.slice());drRender()},
 menu(){goMenu()}
};
