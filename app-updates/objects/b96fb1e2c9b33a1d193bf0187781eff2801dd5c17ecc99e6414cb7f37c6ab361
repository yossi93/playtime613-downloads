#cupboard{position:absolute;left:300px;top:168px;width:680px;height:500px}
.gbox{position:absolute;width:300px;height:212px;border:0;padding:0;background:none;transition:transform .15s}
.gbox:hover{transform:translateY(-6px) rotate(-1deg)}
.gbox:active{transform:translateY(2px)}
.gbox svg{width:100%;height:100%;display:block;filter:drop-shadow(0 8px 6px rgba(0,0,0,.35))}
.gbox .lbl{position:absolute;left:0;right:0;bottom:-2px;text-align:center;font-weight:900;font-size:23px;color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.45)}
#gb-ladders{left:12px;top:20px}#gb-ludo{left:368px;top:20px}#gb-draughts{left:190px;top:272px}
.deco{position:absolute;width:160px;height:150px;top:322px;filter:drop-shadow(0 6px 4px rgba(0,0,0,.3))}#decoL{left:12px}#decoR{left:508px}
