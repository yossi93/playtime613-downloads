#dice .face.f1 .p5,#dice .face.f2 .p1,#dice .face.f2 .p9,#dice .face.f3 .p1,#dice .face.f3 .p5,#dice .face.f3 .p9,#dice .face.f4 .p1,#dice .face.f4 .p3,#dice .face.f4 .p7,#dice .face.f4 .p9,#dice .face.f5 .p1,#dice .face.f5 .p3,#dice .face.f5 .p5,#dice .face.f5 .p7,#dice .face.f5 .p9,#dice .face.f6 .p1,#dice .face.f6 .p3,#dice .face.f6 .p4,#dice .face.f6 .p6,#dice .face.f6 .p7,#dice .face.f6 .p9{visibility:visible}
#dice .face.f1 .p5{width:30px;height:30px;background:radial-gradient(circle at 40% 35%,#ff5a5a,#a01010 70%)}
#dice.dim{opacity:.55}
#rollBtn{border:0;border-radius:22px;width:180px;height:92px;font-size:34px;font-weight:900;color:#3a2000;background:linear-gradient(#ffe27a,#ffb703);box-shadow:0 7px 0 #b97f00,0 10px 14px rgba(0,0,0,.35)}
