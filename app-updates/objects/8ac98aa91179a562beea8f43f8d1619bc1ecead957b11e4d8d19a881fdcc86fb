#belt{position:absolute;left:232px;right:-40px;top:438px;height:30px;z-index:2;background:linear-gradient(180deg,rgba(0,0,0,.25),rgba(255,255,255,.08) 40%,rgba(0,0,0,.1)),repeating-linear-gradient(90deg,#8a5a32 0 34px,#9c6a3e 34px 36px,#7e5030 36px 68px,#6a4024 68px 70px);transform:skewX(-24deg);transform-origin:0 100%;border-top:3px solid #4e2a10;animation:roll 1.1s linear infinite;box-shadow:0 0 0 1px rgba(0,0,0,.2)}
#belt.stop{animation-play-state:paused}
@keyframes roll{to{background-position:0 0,-70px 0}}
#beltFront{position:absolute;left:232px;right:0;top:468px;height:16px;z-index:2;background:linear-gradient(180deg,#5a3214,#3a1e0a);box-shadow:0 8px 10px rgba(0,0,0,.25)}
#beltEnd{position:absolute;left:220px;top:438px;width:26px;height:46px;border-radius:13px;background:linear-gradient(90deg,#3a1e0a,#7a4a24 45%,#3a1e0a);z-index:2;border:2px solid #2a1406}
#items{position:absolute;left:0;top:0;width:1280px;height:720px;pointer-events:none;z-index:4}
.item{position:absolute;left:0;top:204px;width:272px;height:320px;will-change:transform}
.item .bod{position:absolute;inset:0;transform-origin:136px 251px}
.item .shd{position:absolute;left:21px;top:242px;width:230px;height:30px;border-radius:50%;background:radial-gradient(ellipse,rgba(40,20,5,.45),rgba(40,20,5,0) 70%)}
.item .plate{position:absolute;left:7px;top:222px;width:258px;height:58px;border-radius:50%;background:radial-gradient(ellipse at 50% 40%,#fff 0 52%,#ebe7f2 53% 66%,#3d5aa8 67% 69%,#f4f1f8 70% 86%,#cfc8dc 87%);box-shadow:0 5px 0 #b9b1c9}
.item svg{position:absolute;left:21px;top:4px;width:230px;height:230px;filter:drop-shadow(0 4px 2px rgba(60,30,10,.22))}
.item .nm{position:absolute;left:50%;top:284px;transform:translateX(-50%);white-space:nowrap;background:#fffaf0;border:3px solid #5a3214;border-radius:16px;padding:2px 14px;font-size:21px;font-weight:600;box-shadow:0 3px 0 #5a3214;transition:opacity .2s}
.item.ride .bod{animation:ride 1.4s ease-in-out infinite}
@keyframes ride{0%,100%{transform:rotate(-1.6deg) translateY(0)}25%{transform:rotate(0) translateY(-3px)}50%{transform:rotate(1.6deg) translateY(0)}75%{transform:rotate(0) translateY(-2px)}}
.item.shake .bod{animation:shk .45s}
@keyframes shk{20%,60%{transform:translateX(-9px) rotate(-5deg)}40%,80%{transform:translateX(9px) rotate(5deg)}}
.item.gone .nm{opacity:0}
/* bracha buttons */
#btns{position:absolute;left:10px;right:10px;bottom:10px;height:132px;display:grid;grid-template-columns:repeat(6,1fr);gap:10px;z-index:5}
.bb{position:relative;border-radius:20px;background:var(--c);border:4px solid var(--d);box-shadow:0 6px 0 var(--d),0 9px 14px rgba(0,0,0,.3);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:4px 4px 6px;transition:transform .1s,filter .2s,opacity .2s}
.bb:active,.bb.hit{transform:translateY(4px);box-shadow:0 2px 0 var(--d)}
.bb .ic{width:44px;height:40px}
.bb .en{font-size:25px;font-weight:700;text-shadow:0 2px 0 rgba(0,0,0,.25);line-height:1}
.bb .he{font-size:17px;font-weight:600;direction:rtl;background:rgba(255,255,255,.92);color:#2a1a0a;border-radius:10px;padding:1px 8px;white-space:nowrap;line-height:1.35;max-width:100%;overflow:hidden}
.bb .k{position:absolute;top:5px;left:9px;font-size:13px;opacity:.75;font-weight:600}
.bb.off{display:none}
.bb.no{filter:grayscale(.85) brightness(.85);opacity:.55}
.bb.wrong{animation:shk .4s}
.bb.glow{animation:glow .8s ease-in-out infinite;z-index:2}
@keyframes glow{50%{box-shadow:0 6px 0 var(--d),0 0 0 8px #fff3a0,0 0 26px 12px #ffe066}}
#clue{position:absolute;bottom:150px;left:50%;transform:translateX(-50%);background:#fff3b0;border:3px solid #b08a1a;border-radius:16px;padding:6px 16px;font-size:19px;font-weight:600;z-index:6;white-space:nowrap}
.hidden{display:none!important}
/* sparkles */
.spark{position:absolute;width:14px;height:14px;z-index:7;pointer-events:none;animation:spk .8s ease-out forwards}
.spark:before{content:"";position:absolute;inset:0;background:var(--sc);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%)}
@keyframes spk{to{transform:translate(var(--dx),var(--dy)) scale(.3) rotate(120deg);opacity:0}}
.pts{position:absolute;z-index:7;font-size:30px;font-weight:700;color:#2e7d32;text-shadow:0 2px 0 #fff;pointer-events:none;animation:up 1s ease-out forwards}
@keyframes up{to{transform:translateY(-60px);opacity:0}}
