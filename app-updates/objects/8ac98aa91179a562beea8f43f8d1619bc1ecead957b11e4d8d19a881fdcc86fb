const locked=i=>i>=2&&window.PT613_UNLOCKED===false;
function renderLevels(){
 const cols=["#e0a03a","#a1887f","#4caf50","#e8784a","#9c4fb8"];
 $('lvlList').innerHTML=LV.map((L,i)=>{const s=best[i]||0;return `<button class="lvl${locked(i)?' lock':''}" data-lvl="${i}"><span class="n" style="--c:${cols[i]}">${i+1}</span><span>${L.name}</span><span class="s">${L.sub}</span><span class="st">${locked(i)?'🔒':'★'.repeat(s)+'<span style="color:#ddd0b8">'+'★'.repeat(3-s)+'</span>'}</span></button>`;}).join('');
 document.querySelectorAll('#lvlList .lvl').forEach(b=>b.onclick=()=>{const i=+b.dataset.lvl; SFX.click(); if(locked(i)){ $('lockNote').classList.remove('hidden'); return; } startGame(i);});
}
/* ---------- music (gentle WebAudio loop) ---------- */
const MUS={on:LS.get('pt613_music_brachos','1')!=='0',ctx:null,g:null,timer:0,next:0,step:0};
function actx(){ if(window.PT613BrachosSFX&&window.PT613BrachosSFX.ctx) return window.PT613BrachosSFX.ctx(); if(!MUS.ctx){const C=window.AudioContext||window.webkitAudioContext; if(!C) return null; MUS.ctx=new C();} return MUS.ctx; }
const MEL=[0,4,7,4, 9,7,4,2, 5,4,2,0, 2,4,2,-1, 0,4,7,9, 12,9,7,4, 5,7,9,7, 4,2,0,null];
const BASS=[-12,-12,-15,-15,-7,-7,-5,-5];
function note(c,f,t,d,v,type){const o=c.createOscillator(),g=c.createGain();o.type=type;o.frequency.value=f;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+0.02);g.gain.exponentialRampToValueAtTime(0.0008,t+d);o.connect(g);g.connect(MUS.g);o.start(t);o.stop(t+d+0.05);}
function musTick(){const c=MUS.ctx2; if(!c) return; const spb=60/96/2; while(MUS.next<c.currentTime+0.4){const s=MUS.step%MEL.length; const m=MEL[s]; if(m!==null) note(c,523.25*Math.pow(2,m/12)/2,MUS.next,0.45,0.10,'triangle'); if(s%4===0) note(c,261.63*Math.pow(2,BASS[(s/4)%8]/12)/2,MUS.next,1.1,0.09,'sine'); MUS.next+=spb; MUS.step++;}}
function musStart(){ if(!MUS.on||MUS.timer) return; const c=actx(); if(!c) return; if(c.state==='suspended') c.resume(); MUS.ctx2=c; if(!MUS.g){MUS.g=c.createGain(); MUS.g.gain.value=0.35; const lp=c.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=1800; MUS.g.connect(lp); lp.connect(c.destination);} MUS.next=c.currentTime+0.1; MUS.timer=setInterval(musTick,120); }
function musStop(){ clearInterval(MUS.timer); MUS.timer=0; }
function musLabel(){ const t=MUS.on?'🔊 Music: On':'🔈 Music: Off'; $('musicTog').textContent=t; $('musicTog2').textContent=t; }
function toggleMusic(){ MUS.on=!MUS.on; LS.set('pt613_music_brachos',MUS.on?'1':'0'); musLabel(); MUS.on?musStart():musStop(); }
$('musicTog').onclick=toggleMusic; $('musicTog2').onclick=toggleMusic;
function sfxLabel(){ const s=window.PT613BrachosSFX; $('sfxTog').textContent=(s&&s.on)?'🔔 Sounds: On':'🔕 Sounds: Off'; }
$('sfxTog').onclick=()=>{const s=window.PT613BrachosSFX; if(!s) return; s.on=!s.on; LS.set('pt613_sfx_brachos',s.on?'1':'0'); sfxLabel(); SFX.click();};
document.addEventListener('pointerdown',()=>{ musStart(); },{once:false,passive:true});
document.addEventListener('keydown',()=>{ musStart(); },{passive:true});
/* ---------- fit ---------- */
function fit(){ const W=innerWidth,H=innerHeight,s=Math.min(W/1280,H/720); const st=$('stage'); st.style.transform=`translate(${(W-1280*s)/2}px,${(H-720*s)/2}px) scale(${s})`; }
addEventListener('resize',fit); fit();
/* ---------- game ---------- */
const START_X=1000, END_X=230;
let S=null;
function say(html,oops){ const b=$('bubble'); b.innerHTML=html; b.classList.toggle('oops',!!oops); b.classList.remove('hide'); }
function hush(){ $('bubble').classList.add('hide'); }
function startGame(li){
 SFX.start(); clearItems();
 const L=LV[li]; const q=buildQueue(li);
 S={lvl:li,L,q,i:-1,score:0,streak:0,perfect:0,hints:3,cur:null,paused:false,busy:false,over:false,t0:0};
 ORDER.forEach(k=>{btnEls[k].classList.toggle('off',L.groups.indexOf(k)<0); btnEls[k].classList.remove('no','glow');});
 $('btns').style.gridTemplateColumns=`repeat(${L.groups.length},1fr)`;
 $('lvlName').textContent='Level '+(li+1)+' · '+L.name;
 ['start','over','paused'].forEach(id=>$(id).classList.add('hidden'));
 updHud(); face('happy','wave'); boy.classList.add('wave');
 say(li===0?`Shalom! I'm ${hostName()}. What bracha do we make? Tap the right one!`:li===3?'Watch out — tricky foods, and the table is faster!':'Here comes the food — get ready!');
 setTimeout(()=>{ if(S&&S.lvl===li&&S.i<0) nextFood(); },1300);
 musStart();
}
function updHud(){ if(!S) return; const n=S.q.length, d=Math.max(0,S.i)+(S.cur&&S.cur.done?1:0); $('progTxt').textContent=Math.min(d,n)+'/'+n; $('progFill').style.width=(100*Math.min(d,n)/n)+'%'; $('scoreN').textContent=S.score; $('streak').textContent=S.streak>=3?'🔥'+S.streak:''; $('hintN').textContent=S.hints; $('hintBtn').disabled=!S.hints||!S.cur||S.cur.done; }
function clearItems(){ $('items').innerHTML=''; }
function pose(cls,ms){ boy.classList.add(cls); if(ms) setTimeout(()=>boy.classList.remove(cls),ms); }
const ITEM_TOP=204, HAND={x:229,y:384}, HAND_UP={x:207,y:272}, FOOD_C={x:136,y:121};
function nextFood(){
 if(!S) return; S.i++; ORDER.forEach(k=>btnEls[k].classList.remove('no','glow')); $('clue').classList.add('hidden');
 if(S.i>=S.q.length){ return endLevel(); }
 const f=S.q[S.i]; const el=document.createElement('div'); el.className='item';
 el.innerHTML=`<div class="shd"></div><div class="bod"><div class="plate"></div><svg viewBox="0 0 120 120">${A[f.id]}</svg></div><div class="nm">${f.name}</div>`;
 $('items').appendChild(el);
 const c={f,el,x:START_X,wrong:0,hinted:false,done:false,frozen:false,landing:true};
 S.cur=c; el.style.transform=`translateX(${START_X}px)`;
 const bod=el.querySelector('.bod'), shd=el.querySelector('.shd');
 if(bod.animate){
  bod.animate([{transform:'translateY(-230px) rotate(-6deg)',easing:'cubic-bezier(.55,0,1,.45)'},{transform:'translateY(0) scale(1.06,.92)',offset:.55,easing:'cubic-bezier(0,.55,.45,1)'},{transform:'translateY(-26px) rotate(2deg)',offset:.74,easing:'cubic-bezier(.55,0,1,.45)'},{transform:'translateY(0) scale(1.03,.97)',offset:.88},{transform:'translateY(-5px)',offset:.94},{transform:'none'}],{duration:760});
  shd.animate([{transform:'scale(.35)',opacity:.2},{transform:'scale(1.08)',opacity:1,offset:.55},{transform:'scale(.9)',opacity:.8,offset:.74},{transform:'scale(1)',opacity:1}],{duration:760});
 }
 SFX.whoosh(); setTimeout(()=>SFX.plop&&SFX.plop(),400);
 setTimeout(()=>{ c.landing=false; if(S&&S.cur===c&&!c.done){ el.classList.add('ride'); if(!c.frozen&&!S.paused) $('belt').classList.remove('stop'); } },700);
 if(S.i>0) hush(); face('think'); updHud();
}
function frame(t){
 requestAnimationFrame(frame);
 const dt=Math.min(0.05,(t-(frame.last||t))/1000); frame.last=t;
 if(!S||S.paused||S.over||!S.cur||S.cur.done||S.cur.frozen||S.cur.landing) return;
 const c=S.cur; c.x-=dt*(START_X-END_X)/S.L.speed; c.el.style.transform=`translateX(${c.x}px)`;
 if(c.x<=END_X) miss();
}
requestAnimationFrame(frame);
function sparkle(x,y,n){ const cols=['#ffd23f','#ff7b54','#7bd389','#6ab7ff','#ffffff']; for(let i=0;i<n;i++){const s=document.createElement('div');s.className='spark';const a=Math.random()*6.28,r=50+Math.random()*70;s.style.cssText=`left:${x}px;top:${y}px;--sc:${cols[i%5]};--dx:${Math.cos(a)*r}px;--dy:${Math.sin(a)*r}px`;$('fgLayer').appendChild(s);setTimeout(()=>s.remove(),850);} }
function floatPts(x,y,t){ const p=document.createElement('div'); p.className='pts'; p.textContent=t; p.style.left=x+'px'; p.style.top=y+'px'; $('fgLayer').appendChild(p); setTimeout(()=>p.remove(),1000); }
function flyTo(el,x0,pts,dur,ease){ /* pts: [{x,y,s,r}] in stage coords of the food centre */
 el.style.transformOrigin=`${FOOD_C.x}px ${FOOD_C.y}px`;
 const kf=pts.map(p=>({transform:`translate(${p.x-FOOD_C.x}px,${p.y-ITEM_TOP-FOOD_C.y}px) scale(${p.s}) rotate(${p.r||0}deg)`,opacity:p.o===undefined?1:p.o}));
 if(!el.animate){ const l=kf[kf.length-1]; el.style.transform=l.transform; el.style.opacity=l.opacity; return null; }
 return el.animate(kf,{duration:dur,easing:ease||'ease-in-out',fill:'forwards'});
}
function answer(k){
 if(!S||S.paused||S.over||!S.cur||S.cur.done) return;
 const c=S.cur, b=btnEls[k]; if(!b||b.classList.contains('off')||b.classList.contains('no')) return;
 if(k===c.f.b){
  c.done=true; $('belt').classList.add('stop'); $('clue').classList.add('hidden'); ORDER.forEach(q=>btnEls[q].classList.remove('glow'));
  let pts; if(!c.wrong&&!c.hinted){ S.streak++; S.perfect++; pts=10+Math.min(S.streak-1,5)*2; } else { S.streak=0; pts=4; }
  S.score+=pts; SFX.correct(S.streak);
  const cx=c.x+FOOD_C.x, cy=ITEM_TOP+FOOD_C.y; sparkle(cx,cy-10,10); floatPts(cx-20,200,'+'+pts);
  face(S.streak>=3?'proud':'happy'); pose('reach'); $('boyHost').classList.add('lean');
  const cam=$('cam'); if(cam.animate&&!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)) cam.animate([{transform:'scale(1)'},{transform:'scale(1.04)',offset:.45},{transform:'scale(1)'}],{duration:1500,easing:'ease-in-out'});
  const B=BR[k]; const cheers=['A mechaya!','Geshmak!','Right!','Yasher koach!','Exactly!','Perfect!'];
  say(`${c.wrong?'That\'s it!':S.streak>=3?S.streak+' in a row — a mechaya!':cheers[Math.floor(Math.random()*cheers.length)]} ${c.f.name}: <b>${B.n}</b> — <span class="he">${B.he}</span> · Amen!`);
  const el=c.el; el.classList.remove('ride'); el.classList.add('gone');
  const midX=(cx+HAND.x)/2, midY=Math.min(cy,HAND.y)-90;
  setTimeout(()=>{ flyTo(el,c.x,[{x:cx,y:cy,s:1},{x:cx+(midX-cx)*.5,y:cy-50,s:.85,r:-6},{x:midX,y:midY,s:.65,r:-10},{x:HAND.x+20,y:HAND.y-30,s:.48,r:-4},{x:HAND.x,y:HAND.y,s:.42}],520,'cubic-bezier(.45,0,.35,1)'); },150);
  setTimeout(()=>{ boy.classList.remove('reach'); pose('cheer',600); $('boyHost').classList.remove('lean'); flyTo(el,c.x,[{x:HAND.x,y:HAND.y,s:.42},{x:HAND_UP.x,y:HAND_UP.y,s:.46}],320,'cubic-bezier(.3,1.4,.5,1)'); },680);
  setTimeout(()=>{ pose('hop',560); sparkle(HAND_UP.x,HAND_UP.y,14); flyTo(el,c.x,[{x:HAND_UP.x,y:HAND_UP.y,s:.46},{x:HAND_UP.x,y:HAND_UP.y-10,s:.6,o:0}],260); },1020);
  setTimeout(()=>el.remove(),1320); updHud();
  setTimeout(()=>{ if(S&&S.cur===c){ nextFood(); } }, 1500);
 } else {
  c.wrong++; S.streak=0; c.frozen=true; $('belt').classList.add('stop'); b.classList.add('no','wrong'); setTimeout(()=>b.classList.remove('wrong'),420);
  c.el.classList.add('shake'); setTimeout(()=>{c.el.classList.remove('shake');},460);
  SFX.oops(); face('oh');
  say(`<b>Try again!</b> ${c.f.why}`,true); updHud();
 }
}
function miss(){
 const c=S.cur; c.done=true; S.streak=0; $('belt').classList.add('stop'); SFX.slip();
 face('oops'); say(`Oops, that one slipped by! ${c.f.why}`,true);
 btnEls[c.f.b].classList.add('glow');
 const el=c.el, cx=c.x+FOOD_C.x, cy=ITEM_TOP+FOOD_C.y; el.classList.remove('ride'); el.classList.add('gone');
 flyTo(el,c.x,[{x:cx,y:cy,s:1},{x:cx-60,y:cy-30,s:.95,r:-20},{x:cx-110,y:cy+40,s:.85,r:-70},{x:cx-140,y:cy+190,s:.7,r:-140,o:0}],750,'cubic-bezier(.4,0,.8,.6)');
 setTimeout(()=>el.remove(),800); updHud();
 setTimeout(()=>{ if(S&&S.cur===c){ nextFood(); } }, 2600);
}
function hint(){
 if(!S||!S.cur||S.cur.done||!S.hints||S.paused) return;
 S.hints--; S.cur.hinted=true; const B=BR[S.cur.f.b]; SFX.hint();
 btnEls[S.cur.f.b].classList.add('glow'); $('clue').textContent='💡 '+B.clue; $('clue').classList.remove('hidden');
 S.cur.frozen=true; $('belt').classList.add('stop'); updHud();
}
function endLevel(){
 S.over=true; $('belt').classList.add('stop'); hush();
 const n=S.q.length, r=S.perfect/n; const stars=r>=0.85?3:r>=0.6?2:1;
 if(stars>(best[S.lvl]||0)){ best[S.lvl]=stars; LS.set('pt613_best_brachos',JSON.stringify(best)); }
 $('overH').textContent=stars===3?'A mechaya!':stars===2?'Geshmak!':'Well done!';
 $('stars').innerHTML=[0,1,2].map(i=>`<span class="${i<stars?'on':''}" style="animation-delay:${0.2+i*0.25}s">★</span>`).join('');
 $('overTxt').innerHTML=`Level ${S.lvl+1} · ${S.L.name}<br>Right first time: <b>${S.perfect} of ${n}</b> &nbsp;·&nbsp; Score: <b>${S.score}</b>`;
 const hasNext=S.lvl<LV.length-1&&!locked(S.lvl+1); $('next').classList.toggle('hidden',!hasNext);
 setTimeout(()=>{ $('over').classList.remove('hidden'); SFX.win(stars); face(stars===3?'proud':'happy','wave'); },400);
 renderLevels();
}
function pause(){ if(!S||S.over||S.paused) return; S.paused=true; $('belt').classList.add('stop'); $('paused').classList.remove('hidden'); SFX.click(); }
function resume(){ if(!S||!S.paused) return; S.paused=false; $('paused').classList.add('hidden'); if(S.cur&&!S.cur.done&&!S.cur.frozen&&!S.cur.landing) $('belt').classList.remove('stop'); }
function toMenu(){ if(S){S.over=true;} S=null; clearItems(); hush(); ['paused','over'].forEach(id=>$(id).classList.add('hidden')); $('lockNote').classList.add('hidden'); renderLevels(); $('start').classList.remove('hidden'); $('belt').classList.add('stop'); }
$('btns').addEventListener('click',e=>{const b=e.target.closest('.bb'); if(b) answer(b.dataset.k);});
$('hintBtn').onclick=hint; $('pause').onclick=pause; $('resume').onclick=resume; $('toMenu').onclick=toMenu; $('menu').onclick=()=>{SFX.click();toMenu();};
$('again').onclick=()=>{SFX.click(); startGame(S.lvl);}; $('next').onclick=()=>{SFX.click(); startGame(S.lvl+1);};
document.addEventListener('keydown',e=>{
 if(window.PT613Tour&&PT613Tour.isOpen&&PT613Tour.isOpen()) return;
 if(!S||S.over) return;
 if(e.key==='Escape'||e.key==='p'||e.key==='P'){ S.paused?resume():pause(); e.preventDefault(); return; }
 if(S.paused) return;
 if(e.key==='h'||e.key==='H'){ hint(); return; }
 const vis=ORDER.filter(k=>!btnEls[k].classList.contains('off'));
 const n=parseInt(e.key,10); if(n>=1&&n<=vis.length){ const k=vis[n-1]; btnEls[k].classList.add('hit'); setTimeout(()=>btnEls[k].classList.remove('hit'),120); answer(k); }
});
/* key labels follow the visible buttons */
const _sg=startGame; 
function relabel(){ const vis=ORDER.filter(k=>!btnEls[k].classList.contains('off')); vis.forEach((k,i)=>btnEls[k].querySelector('.k').textContent=i+1); }
new MutationObserver(relabel).observe($('btns'),{subtree:true,attributes:true,attributeFilter:['class']});
renderLevels(); musLabel(); sfxLabel(); renderChar();
document.querySelectorAll('[data-char]').forEach(b=>b.onclick=()=>{SFX.click(); setChar(b.dataset.char);});
$('charTog2').onclick=()=>{SFX.click(); setChar(CHAR==='boy'?'girl':'boy');};
/* ---------- test/debug hook (used by the automated checks; harmless for players) ---------- */
window.__brachos={
 start:i=>startGame(i), state:()=>S&&{lvl:S.lvl,i:S.i,n:S.q.length,score:S.score,perfect:S.perfect,over:S.over,cur:S.cur&&S.cur.f.id,curB:S.cur&&S.cur.f.b,done:S.cur&&S.cur.done,landing:S.cur&&S.cur.landing},
 right:()=>{ if(S&&S.cur&&!S.cur.done) answer(S.cur.f.b); }, wrong:()=>{ if(S&&S.cur&&!S.cur.done){ const k=S.L.groups.find(g=>g!==S.cur.f.b&&!btnEls[g].classList.contains('no')); answer(k);} },
 skipWait:()=>{ if(S&&S.cur&&S.cur.done&&!S.over) nextFood(); },
 char:()=>CHAR, setChar, foods:FOODS, brachos:BR, levels:LV, buildQueue
};
})();

</script>
<script src="how-to-play.js"></script>
<script src="sfx.js"></script>
