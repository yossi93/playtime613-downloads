.ov{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;background:rgba(40,22,8,.55)}
.card{background:#fffaf0;border:5px solid #5a3214;border-radius:30px;box-shadow:0 8px 0 #5a3214,0 20px 50px rgba(0,0,0,.5);padding:22px 34px;text-align:center;position:relative}
#start .card{width:760px;padding-left:200px;text-align:left}
#start .cboy{position:absolute;left:-10px;bottom:-6px;width:200px;height:420px}
#start h1{font-size:54px;color:#7a2a12;line-height:1}
#start h1 span{display:block;font-size:26px;color:#8a6a3a;direction:rtl;text-align:left;margin-top:6px}
#start .tag{font-size:19px;color:#5a4028;margin:8px 0 12px}
.levels{display:flex;flex-direction:column;gap:8px}
.lvl{display:flex;align-items:center;gap:12px;background:#fff;border:3px solid #5a3214;border-radius:18px;padding:7px 14px;font-size:20px;font-weight:600;color:#3a2410;box-shadow:0 4px 0 #5a3214;text-align:left}
.lvl:hover{background:#fff3d0}
.lvl .n{width:36px;height:36px;border-radius:50%;background:var(--c,#e8784a);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;flex:none}
.lvl .s{font-size:15px;color:#7a5a3a;font-weight:400;flex:1}
.lvl .st{font-size:18px;letter-spacing:1px;color:#e0a000}
.lvl.lock{opacity:.6}
.hint{font-size:14px;color:#8a6a4a;margin-top:8px}
.row{display:flex;gap:10px;justify-content:center;margin-top:12px}
.big{font-size:22px;font-weight:700;padding:12px 26px;border-radius:22px;background:#4caf50;color:#fff;border:4px solid #2e7d32;box-shadow:0 5px 0 #2e7d32}
.big.alt{background:#fff;color:#3a2410;border-color:#5a3214;box-shadow:0 5px 0 #5a3214}
.big.gold{background:#f7c548;color:#3a2410;border-color:#b08a1a;box-shadow:0 5px 0 #b08a1a}
#over h2{font-size:46px;color:#7a2a12}
#stars{font-size:72px;letter-spacing:8px;margin:4px 0;color:#d9c9a8}
#stars .on{color:#ffbf00;text-shadow:0 3px 0 #b07a00;display:inline-block;animation:pop .5s backwards}
@keyframes pop{0%{transform:scale(0)}70%{transform:scale(1.3)}100%{transform:scale(1)}}
#overTxt{font-size:22px;color:#5a4028;line-height:1.5}
#paused .card{width:420px}
#paused h2{font-size:40px;margin-bottom:12px}
.tog{font-size:16px;padding:7px 14px;border-radius:16px;background:#fff;border:3px solid #5a3214;color:#3a2410;font-weight:600}
.charRow{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:17px;font-weight:600;color:#5a4028}
.chr{font-size:17px;font-weight:600;padding:6px 16px;border-radius:16px;background:#fff;border:3px solid #5a3214;color:#3a2410;box-shadow:0 3px 0 #5a3214}
.chr.on{background:#f7c548;border-color:#b08a1a;box-shadow:0 3px 0 #b08a1a}
#lockNote{font-size:16px;color:#7a2a12;margin-top:6px}
</style>
</head>
