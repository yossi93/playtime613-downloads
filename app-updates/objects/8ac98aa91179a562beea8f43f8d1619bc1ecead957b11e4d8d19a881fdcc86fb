#stage{position:absolute;left:0;top:0;width:1280px;height:720px;transform-origin:0 0;overflow:hidden;border-radius:6px}
#cam,.layer,#sceneHost,#frontHost,#lightHost,#sceneHost svg,#frontHost svg,#lightHost svg{position:absolute;left:0;top:0;width:1280px;height:720px}
#cam{transform-origin:330px 400px;z-index:0}
#lightHost{pointer-events:none;z-index:8}
#frontHost{pointer-events:none}
.layer{transform-origin:640px 360px}
#bgLayer{animation:driftB 22s ease-in-out infinite}
#fgLayer{animation:driftF 22s ease-in-out infinite}
@keyframes driftB{0%,100%{transform:scale(1.02) translate(0,0)}33%{transform:scale(1.02) translate(-5px,-2px)}66%{transform:scale(1.02) translate(4px,-3px)}}
@keyframes driftF{0%,100%{transform:scale(1.02) translate(0,0)}33%{transform:scale(1.02) translate(-10px,-3px)}66%{transform:scale(1.02) translate(8px,-4px)}}
@media (prefers-reduced-motion: reduce){#bgLayer,#fgLayer{animation:none;transform:scale(1.02)}}
button{font-family:inherit;cursor:pointer;border:none}
/* HUD */
#hud{position:absolute;left:14px;right:14px;top:10px;height:52px;display:flex;align-items:center;gap:10px;z-index:5}
.pill{background:rgba(255,250,238,.95);border:3px solid #5a3214;border-radius:30px;height:48px;display:flex;align-items:center;padding:0 16px;font-weight:600;font-size:20px;box-shadow:0 3px 0 #5a3214}
#tTitle{font-size:22px;color:#7a2a12}
#tTitle small{font-size:15px;color:#7a5a3a;margin-left:8px}
#prog{flex:1;max-width:300px;padding:0 12px;gap:8px}
#progBar{flex:1;height:14px;background:#ead8b8;border-radius:8px;overflow:hidden;border:2px solid #b08850}
