<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#3a2412;font-family:'Fredoka',system-ui,sans-serif;color:#2a1a0a;-webkit-user-select:none;user-select:none;touch-action:manipulation}
