/* Chess Studio sound: every sound is made here with WebAudio (no files, no network).
   CSSFX.play(name): move, capture, check, castle, promote, win, draw, lose, click, step, snap, tumble, nope, hint
   CSSFX.music(on): a soft, slow wooden-marimba loop (switch: pt613_music_chess-studio, ON by default). */
(function(){
if(window.CSSFX) return;
var ctx=null, out=null, mus=null, musOn=false, musT=0, musStep=0;
function C(){ if(!ctx){ try{ var A=window.AudioContext||window.webkitAudioContext; if(!A) return null; ctx=new A(); out=ctx.createGain(); out.gain.value=0.55; out.connect(ctx.destination);}catch(e){ ctx=null; return null; } }
  if(ctx.state==='suspended'){ try{ ctx.resume(); }catch(e){} } return ctx; }
function tone(f,t,d,o){ o=o||{}; var c=C(); if(!c) return; var os=c.createOscillator(), g=c.createGain();
  os.type=o.type||'sine'; os.frequency.setValueAtTime(f,t); if(o.to) os.frequency.exponentialRampToValueAtTime(o.to,t+d);
  var v=o.vol==null?0.3:o.vol; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(v,t+(o.att||0.006)); g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  os.connect(g); g.connect(o.dest||out); os.start(t); os.stop(t+d+0.05); }
var nb=null;
function noise(t,d,o){ o=o||{}; var c=C(); if(!c) return; if(!nb){ nb=c.createBuffer(1,c.sampleRate,c.sampleRate); var a=nb.getChannelData(0); for(var i=0;i<a.length;i++) a[i]=Math.random()*2-1; }
  var s=c.createBufferSource(); s.buffer=nb; var f=c.createBiquadFilter(); f.type=o.ft||'bandpass'; f.frequency.setValueAtTime(o.f||2000,t); if(o.fto) f.frequency.exponentialRampToValueAtTime(o.fto,t+d); f.Q.value=o.q||1.2;
  var g=c.createGain(), v=o.vol==null?0.3:o.vol; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(v,t+0.004); g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  s.connect(f); f.connect(g); g.connect(out); s.start(t,Math.random()*0.5); s.stop(t+d+0.05); }
function knock(t,v){ noise(t,0.06,{f:900,q:1.5,vol:0.45*(v||1)}); tone(210,t,0.08,{type:'triangle',vol:0.22*(v||1),to:150}); }
var SND={
  move:function(t){ knock(t,1); },
  capture:function(t){ knock(t,1.1); knock(t+0.07,0.7); tone(520,t+0.12,0.16,{type:'triangle',vol:0.08}); },
  castle:function(t){ knock(t,1); knock(t+0.16,0.9); },
  check:function(t){ tone(660,t,0.14,{type:'triangle',vol:0.16}); tone(880,t+0.12,0.22,{type:'triangle',vol:0.16}); },
  promote:function(t){ [523,659,784,1047].forEach(function(f,i){ tone(f,t+i*0.07,0.24,{type:'triangle',vol:0.15}); }); },
  win:function(t){ var n=[523,659,784,1047,784,1047,1319]; for(var i=0;i<n.length;i++){ tone(n[i],t+i*0.12,0.35,{type:'triangle',vol:0.2}); tone(n[i]*2,t+i*0.12,0.2,{vol:0.05}); } for(var j=0;j<14;j++) noise(t+0.9+j*0.05,0.04,{f:4000+Math.random()*3000,q:4,vol:0.12}); },
  draw:function(t){ [523,659,784,659].forEach(function(f,i){ tone(f,t+i*0.13,0.3,{type:'triangle',vol:0.14}); }); },
  lose:function(t){ [392,440,523,659].forEach(function(f,i){ tone(f,t+i*0.14,0.3,{type:'triangle',vol:0.13}); }); },
  click:function(t){ tone(880,t,0.05,{type:'triangle',vol:0.12}); },
  step:function(t){ noise(t,0.025,{f:3200,q:3,vol:0.12}); tone(1200,t,0.03,{type:'triangle',vol:0.03}); },
  snap:function(t){ noise(t,0.03,{f:4200,q:5,vol:0.35}); tone(1500,t,0.04,{type:'square',vol:0.05}); noise(t+0.035,0.03,{f:2600,q:4,vol:0.25}); },
  tumble:function(t){ for(var i=0;i<10;i++){ var k=t+i*0.045+Math.random()*0.03; noise(k,0.03,{f:2500+Math.random()*3000,q:4,vol:0.22}); tone(900+Math.random()*900,k,0.03,{type:'square',vol:0.03}); } },
  nope:function(t){ tone(220,t,0.12,{type:'triangle',vol:0.12}); },
  hint:function(t){ tone(988,t,0.12,{type:'sine',vol:0.12}); tone(1319,t+0.1,0.2,{type:'sine',vol:0.1}); }
};
function play(n){ var c=C(); if(!c||!SND[n]) return false; try{ SND[n](c.currentTime+0.01); window.CSSFX.played++; window.CSSFX.last=n; return true; }catch(e){ return false; } }
var MEL=[[0,4,7,4],[7,9,7,4],[4,2,0,2],[2,4,7,9],[9,7,4,2]], BASS=[0,-5,-3,-7];
function musTick(){ if(!musOn) return; var c=C(); if(!c||c.state!=='running'){ musT=setTimeout(musTick,400); return; }
  var t=c.currentTime+0.05, beat=0.36, bar=MEL[(Math.random()*MEL.length)|0], root=BASS[musStep%4];
  tone(110*Math.pow(2,(root+12)/12),t,beat*3.8,{type:'sine',vol:0.06,dest:mus});
  for(var i=0;i<8;i++){ if(i%2===1&&Math.random()<0.6) continue; var s=bar[i%4];
    tone(392*Math.pow(2,s/12),t+i*beat,0.3,{type:'triangle',vol:0.04,dest:mus}); }
  musStep++; musT=setTimeout(musTick,beat*8*1000); }
function music(on){ musOn=!!on; clearTimeout(musT); var c=C(); if(!c) return; if(!mus){ mus=c.createGain(); mus.gain.value=1; mus.connect(out); }
  if(on){ mus.gain.cancelScheduledValues(c.currentTime); mus.gain.setValueAtTime(1,c.currentTime); musTick(); }
  else { mus.gain.setTargetAtTime(0,c.currentTime,0.05); } window.CSSFX.musicOn=musOn; }
function wake(){ var c=C(); if(c&&c.state==='suspended'){ try{ c.resume(); }catch(e){} } }
try{ window.addEventListener('pointerdown',wake,true); window.addEventListener('keydown',wake,true); }catch(e){}
window.CSSFX={play:play,music:music,played:0,last:'',musicOn:false};
})();
