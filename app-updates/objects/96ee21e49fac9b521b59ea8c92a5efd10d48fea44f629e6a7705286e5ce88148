/* Board Game Box sound: every sound is made here with WebAudio (no files, no network).
   BGSFX.play(name): dice, hop, ladder, slide, capture, win, click, home, six, oops, king, nope
   BGSFX.music(on): a soft wooden-marimba loop (switch: pt613_music_board-games, ON by default). */
(function(){
if(window.BGSFX) return;
var ctx=null, out=null, mus=null, musOn=false, musT=0, musStep=0;
function C(){ if(!ctx){ try{ var A=window.AudioContext||window.webkitAudioContext; if(!A) return null; ctx=new A(); out=ctx.createGain(); out.gain.value=0.55; out.connect(ctx.destination);}catch(e){ ctx=null; return null; } }
  if(ctx.state==='suspended'){ try{ ctx.resume(); }catch(e){} } return ctx; }
function tone(f,t,d,o){ o=o||{}; var c=C(); if(!c) return; var os=c.createOscillator(), g=c.createGain();
  os.type=o.type||'sine'; os.frequency.setValueAtTime(f,t); if(o.to) os.frequency.exponentialRampToValueAtTime(o.to,t+d);
  var v=o.vol==null?0.3:o.vol; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(v,t+(o.att||0.008)); g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  os.connect(g); g.connect(o.dest||out); os.start(t); os.stop(t+d+0.05); }
var nb=null;
function noise(t,d,o){ o=o||{}; var c=C(); if(!c) return; if(!nb){ nb=c.createBuffer(1,c.sampleRate,c.sampleRate); var a=nb.getChannelData(0); for(var i=0;i<a.length;i++) a[i]=Math.random()*2-1; }
  var s=c.createBufferSource(); s.buffer=nb; var f=c.createBiquadFilter(); f.type=o.ft||'bandpass'; f.frequency.setValueAtTime(o.f||2000,t); if(o.fto) f.frequency.exponentialRampToValueAtTime(o.fto,t+d); f.Q.value=o.q||1.2;
  var g=c.createGain(), v=o.vol==null?0.3:o.vol; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(v,t+0.005); g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  s.connect(f); f.connect(g); g.connect(out); s.start(t,Math.random()*0.5); s.stop(t+d+0.05); }
var SND={
  dice:function(t){ for(var i=0;i<9;i++){ var k=t+i*0.055+Math.random()*0.02; noise(k,0.05,{f:2500+Math.random()*2500,q:3,vol:0.35}); tone(700+Math.random()*500,k,0.04,{type:'triangle',vol:0.08}); } noise(t+0.55,0.09,{f:900,q:1,vol:0.4}); tone(180,t+0.55,0.1,{type:'triangle',vol:0.2}); },
  hop:function(t){ tone(520,t,0.09,{type:'triangle',to:780,vol:0.18}); noise(t+0.06,0.04,{f:1500,vol:0.12}); },
  ladder:function(t){ for(var i=0;i<6;i++) tone(400*Math.pow(1.12,i),t+i*0.07,0.1,{type:'square',vol:0.06}); tone(1000,t+0.45,0.25,{vol:0.15}); },
  slide:function(t){ tone(900,t,0.8,{type:'triangle',to:180,vol:0.22}); noise(t,0.8,{f:3000,fto:400,vol:0.08,q:0.7}); },
  capture:function(t){ tone(300,t,0.12,{type:'square',to:120,vol:0.12}); noise(t,0.12,{f:600,vol:0.3}); tone(660,t+0.13,0.2,{type:'triangle',vol:0.15}); },
  win:function(t){ var n=[523,659,784,1047,784,1047,1319]; for(var i=0;i<n.length;i++){ tone(n[i],t+i*0.12,0.35,{type:'triangle',vol:0.2}); tone(n[i]*2,t+i*0.12,0.2,{vol:0.05}); } for(var j=0;j<14;j++) noise(t+0.9+j*0.05,0.04,{f:4000+Math.random()*3000,q:4,vol:0.12}); },
  click:function(t){ tone(880,t,0.05,{type:'triangle',vol:0.12}); },
  home:function(t){ tone(660,t,0.15,{type:'triangle',vol:0.18}); tone(990,t+0.12,0.25,{type:'triangle',vol:0.18}); },
  six:function(t){ tone(784,t,0.1,{type:'triangle',vol:0.15}); tone(1175,t+0.08,0.18,{type:'triangle',vol:0.15}); },
  oops:function(t){ tone(440,t,0.18,{type:'triangle',to:330,vol:0.18}); tone(330,t+0.18,0.25,{type:'triangle',to:220,vol:0.18}); },
  king:function(t){ [523,659,784,1047].forEach(function(f,i){ tone(f,t+i*0.08,0.25,{type:'triangle',vol:0.16}); }); },
  nope:function(t){ tone(200,t,0.15,{type:'square',vol:0.06}); },
  tap:function(t){ noise(t,0.04,{f:1200,vol:0.25}); tone(240,t,0.06,{type:'triangle',vol:0.15}); }
};
function play(n){ var c=C(); if(!c||!SND[n]) return false; try{ SND[n](c.currentTime+0.01); window.BGSFX.played++; window.BGSFX.last=n; return true; }catch(e){ return false; } }
/* music: gentle pentatonic marimba, 2 bars that vary */
var MEL=[[0,4,7,9],[7,9,12,9],[4,7,9,7],[2,4,7,4],[0,2,4,7],[9,7,4,2]], BASS=[0,-5,-3,-7];
function musTick(){ if(!musOn) return; var c=C(); if(!c||c.state!=='running'){ musT=setTimeout(musTick,400); return; }
  var t=c.currentTime+0.05, beat=0.24, bar=MEL[(Math.random()*MEL.length)|0], root=BASS[musStep%4];
  tone(110*Math.pow(2,(root+12)/12),t,beat*3.6,{type:'sine',vol:0.07,dest:mus});
  for(var i=0;i<8;i++){ if(i%2===1&&Math.random()<0.45) continue; var s=bar[i%4]+(i>=4?2*((musStep%2)):0);
    tone(523*Math.pow(2,s/12),t+i*beat,0.22,{type:'triangle',vol:0.05,dest:mus}); tone(1046*Math.pow(2,s/12),t+i*beat,0.08,{type:'sine',vol:0.012,dest:mus}); }
  musStep++; musT=setTimeout(musTick,beat*8*1000); }
function music(on){ musOn=!!on; clearTimeout(musT); var c=C(); if(!c) return; if(!mus){ mus=c.createGain(); mus.gain.value=1; mus.connect(out); }
  if(on){ mus.gain.cancelScheduledValues(c.currentTime); mus.gain.setValueAtTime(1,c.currentTime); musTick(); }
  else { mus.gain.setTargetAtTime(0,c.currentTime,0.05); } window.BGSFX.musicOn=musOn; }
function wake(){ var c=C(); if(c&&c.state==='suspended'){ try{ c.resume(); }catch(e){} } }
try{ window.addEventListener('pointerdown',wake,true); window.addEventListener('keydown',wake,true); }catch(e){}
window.BGSFX={play:play,music:music,played:0,last:'',musicOn:false,ctx:function(){return ctx;}};
})();
